[[1.02, 5.666, "“황후의 비단옷이오! 금실로 수놓은, 황후의 옷이오!”", "nar"], [6.334874999999999, 9.4355, "기원후 백육십구 년, 로마 트라야누스 광장.", "nar"], [9.90485, 13.298, "황제가, 궁전의 보물을 시장에 내놓았습니다.", "nar"], [13.879708, 17.1611, "황금 잔과 수정 그릇, 그리고 황후의 옷까지.", "nar"], [17.4124, 19.442, "사람들은 수군거렸습니다.", "nar"], [19.812000000000005, 24.122, "“철학에 빠진 황제가, 이제는 장사꾼이 되었군.”", "nar"], [24.892000000000003, 27.282, "아무도 알아주지 않을 것이다.", "mono"], [27.552000000000003, 29.822, "그래도, 나는 한다.", "emph"], [46.663313, 47.492708, "삼 년 전.", "nar"], [47.570600000000006, 51.954, "동방 원정을 마친 군대가, 승리의 행렬을 이루며 로마로 돌아왔습니다.", "nar"], [53.16577100000001, 56.67085, "그런데 그 행렬과 함께, 보이지 않는 손님이 따라 들어왔습니다.", "nar"], [56.64340000000001, 58.09, "역병이었습니다.", "nar"], [59.17125000000001, 64.96277, "훗날 안토니누스 역병이라 불린 이 병은, 제국 곳곳에서 수많은 목숨을 앗아 갔습니다.", "nar"], [65.15050000000001, 69.86600000000001, "의사 갈레노스는, 열병과 붉은 발진을 기록으로 남겼습니다.", "nar"], [70.63600000000001, 73.55400000000002, "황제는 로마를 떠나지 않았습니다.", "nar"], [79.58429200000002, 82.08754000000002, "시신은 수레에 실려 나갔습니다.", "nar"], [82.24346000000001, 86.08200000000002, "가난한 사람들에게는, 장례를 치를 돈조차 없었습니다.", "nar"], [86.352, 91.86200000000001, "황제는 나라의 돈으로, 가난한 이들의 장례를 치러 주게 했다고 전해집니다.", "nar"], [92.63200000000002, 102.10200000000002, "“우리 남편 장례를, 황제께서 치러 주셨대요. 그런데 그분 얼굴은, 한 번도 못 봤어요.”", "nar"], [102.37200000000001, 105.89000000000001, "황제는 그 일을, 어디에도 드러내지 않았습니다.", "nar"], [107.06, 112.018, "어떤 사람은 남에게 잘해 주고, 그 빚을 꼭 받아 내려 한다.", "mono"], [112.78800000000001, 117.98600000000002, "어떤 사람은 입으로는 말하지 않아도, 마음속에 장부를 적는다.", "mono"], [126.31241700000001, 131.10154000000003, "황제는 좋은 사람을, 포도를 맺고도 자랑하지 않는 포도나무에 비유했습니다.", "nar"], [131.40454, 137.098, "열매를 맺는 것이 포도나무의 본성이듯, 선을 행하는 것이 사람의 본성이라는 겁니다.", "nar"], [138.00416699999997, 140.2274, "삼십 년 동안 차려 온 저녁 밥상.", "nar"], [140.26505999999998, 144.234, "고맙다는 말은 없는데, 내일도 밥은 차려야 합니다.", "nar"], [144.55399999999997, 149.224, "알아주는 사람이 없어도, 그 밥상은 가족을 살렸습니다.", "emph"], [152.944, 157.35, "그리고 그해 겨울, 황제에게 또 하나의 소식이 날아들었습니다.", "nar"], [163.11999999999998, 170.022, "북쪽 전선으로 함께 가던 길, 공동 황제이자 아우인 루키우스가, 마차 안에서 쓰러졌습니다.", "nar"], [171.05510399999997, 173.38370999999998, "루키우스는 끝내 일어나지 못했습니다.", "nar"], [173.56949999999998, 177.862, "황제는 아우를 신으로 모시는 장례를, 정성껏 치러 주었습니다.", "nar"], [178.63199999999998, 182.24599999999998, "그러나 로마에는, 이상한 소문이 돌았습니다.", "nar"], [182.51599999999996, 185.76999999999998, "“황제가, 자기 아우를 독살했다더군.”", "nar"], [186.03999999999996, 189.65399999999997, "황제는 그 소문에, 한마디도 답하지 않았습니다.", "nar"], [190.82399999999998, 194.318, "너는 선을 행했고, 그는 그 덕을 보았다.", "mono"], [195.08799999999997, 198.70199999999997, "그런데 왜, 바보처럼 세 번째 것을 찾는가.", "mono"], [207.96206199999997, 212.44096, "황제는 선을 행하는 일과, 그 일로 인정받는 일을 분명히 나누었습니다.", "nar"], [212.40937999999997, 216.134, "앞의 것은 내 몫이고, 뒤의 것은 남의 몫이라는 겁니다.", "nar"], [216.91574999999995, 219.70086999999998, "십 년 동안 홀로 어머니 병간호를 했습니다.", "nar"], [220.09489999999994, 224.61399999999998, "그런데 장례식장에서, 친척들은 한마디씩 거들기만 했습니다.", "nar"], [224.93399999999994, 229.29199999999994, "내가 한 일은, 남이 알아줘야 완성되는 일이 아닙니다.", "emph"], [233.01199999999994, 236.91399999999996, "그해 봄, 제국의 금고가 바닥을 드러냈습니다.", "nar"], [242.94372899999993, 247.30509999999995, "역병으로 사람이 줄고, 북쪽에서는 게르만족이 국경을 넘어왔습니다.", "nar"], [247.72264999999993, 250.13799999999995, "그런데 군대를 꾸릴 돈이, 없었습니다.", "nar"], [250.90799999999993, 253.72999999999996, "원로원은 손쉬운 길을 말했습니다.", "nar"], [253.79999999999993, 256.6219999999999, "“세금을 더 걷으면 됩니다, 폐하.”", "nar"], [256.95235399999996, 259.4421499999999, "그러나 황제는 고개를 저었습니다.", "nar"], [259.62249999999995, 263.1619999999999, "그리고 아무도 예상하지 못한 결정을 내렸습니다.", "nar"], [263.532, 265.68199999999996, "“궁전의 것을, 팔겠소.”", "mono"], [266.852, 270.46599999999995, "죽은 뒤의 이름에 매달리는 사람은 잊는다.", "mono"], [271.236, 275.73799999999994, "그를 기억하는 사람들도, 곧 모두 떠난다는 것을.", "mono"], [282.79935399999994, 285.10874999999993, "세금을 올리면 쉬웠을 겁니다.", "nar"], [285.29932999999994, 289.1636299999999, "하지만 그 짐은, 역병에 지친 백성이 졌을 겁니다.", "nar"], [289.50684999999993, 293.86599999999993, "황제는 이름을 남기는 일보다, 오늘의 옳은 일을 앞에 두었습니다.", "nar"], [294.69066699999996, 296.43391999999994, "또 밀린 승진 발표날.", "nar"], [296.57489999999996, 299.70599999999996, "밤새 만든 보고서는, 상사의 이름으로 올라갔습니다.", "nar"], [300.02599999999995, 303.83199999999994, "이름은 남이 가져가도, 그 일을 해낸 사람은 나입니다.", "emph"], [307.5519999999999, 312.17399999999986, "그렇게 트라야누스 광장에, 경매대가 세워졌습니다.", "nar"], [318.2214379999999, 320.74176999999986, "경매는, 두 달 동안 이어졌다고 전해집니다.", "nar"], [320.9125599999999, 325.61399999999986, "황금 잔과 수정 그릇, 대대로 내려온 조각상까지 하나씩 팔려 나갔습니다.", "nar"], [326.5937079999999, 328.0334599999999, "사람들은 웃었습니다.", "nar"], [328.2265999999999, 329.84036999999984, "황제가 체면을 잃었다고.", "nar"], [329.9801199999999, 332.34999999999985, "황후의 옷까지 내다 파는 황제라고.", "nar"], [332.4199999999999, 335.45799999999986, "“더 부르실 분 없소? 팔렸소!”", "nar"], [336.2279999999999, 341.73799999999983, "그렇게 모은 돈으로, 황제는 백성에게 세금을 더 걷지 않고 군대를 꾸렸습니다.", "nar"], [342.9079999999999, 348.0579999999999, "추울 때든 따뜻할 때든, 졸릴 때든 푹 잤을 때든.", "mono"], [348.8279999999999, 351.60199999999986, "칭찬을 듣든, 비난을 듣든.", "mono"], [359.0325829999999, 362.04539999999986, "스토아 철학자들은 이것을, 의무라고 불렀습니다.", "nar"], [362.6005999999999, 366.44199999999984, "남의 박수와 상관없이, 내 자리에서 마땅히 할 일입니다.", "nar"], [367.2176669999999, 369.88959999999986, "새벽 세 시, 아무도 보지 않는 병동.", "nar"], [369.8449199999999, 372.80999999999983, "간호사는 잠든 환자의 이불을, 다시 덮어 줍니다.", "nar"], [373.1299999999999, 377.58399999999983, "아무도 보지 않는 일이, 세상을 굴러가게 합니다.", "emph"], [381.46879199999984, 383.4729399999998, "몇 해 뒤, 다뉴브 전선.", "nar"], [383.5981199999999, 387.4139999999998, "큰 승리를 거둔 병사들이, 황제 앞에 모여들었습니다.", "nar"], [393.62220799999983, 395.57422999999983, "병사들은 상여금을 요구했습니다.", "nar"], [395.69464999999985, 399.1499999999998, "목숨을 걸고 싸웠으니, 그만한 상을 달라는 것이었습니다.", "nar"], [399.21999999999986, 405.3779999999998, "“폐하, 우리는 피를 흘렸습니다. 그에 맞는 상을 주십시오.”", "nar"], [406.3607499999999, 407.9197699999998, "황제는 거절했습니다.", "nar"], [408.0529799999999, 410.4099999999998, "그리고 이렇게 말했다고 전해집니다.", "nar"], [410.47999999999985, 416.4939999999998, "“그대들에게 더 주는 것은, 그대들 부모와 형제의 피에서 짜내는 것이오.”", "mono"], [416.8024369999998, 418.32962999999984, "병사들은 투덜거렸습니다.", "nar"], [418.47184999999985, 421.76199999999983, "인기를 얻기 쉬운 길을, 황제는 또 마다한 것입니다.", "nar"], [422.9319999999999, 426.4259999999999, "사람은 누구보다 자기를 사랑하면서도,", "mono"], [427.1959999999999, 431.81799999999987, "자기 생각보다, 남의 생각을 더 무겁게 여긴다.", "mono"], [438.9036869999999, 441.2644999999998, "황제에게 인기는 목표가 아니었습니다.", "nar"], [441.3099799999999, 445.60199999999986, "옳다고 판단한 일이 인기가 없을 때, 그는 판단 쪽을 택했습니다.", "nar"], [446.6477079999999, 449.5267899999999, "우리 반에서 나만 휴대폰이 없다는 아이의 말.", "nar"], [449.44803999999993, 452.7379999999999, "엄마의 마음은, 하루에도 몇 번씩 흔들립니다.", "nar"], [453.05799999999994, 456.5759999999999, "미움받는 결정이, 틀린 결정은 아닙니다.", "emph"], [460.29599999999994, 465.1099999999999, "그날 밤, 막사에서 황제는, 자신을 비웃는 말들을 떠올렸습니다.", "nar"], [471.14539599999995, 475.3491199999999, "로마에는 그를, 철학자 황제라고 비꼬는 사람들이 있었습니다.", "nar"], [476.02309999999994, 478.6939999999999, "책을 붙들고 생각만 하는 황제라고.", "nar"], [479.46399999999994, 484.1339999999999, "그러나 그날 밤 일기에, 황제는 다른 이야기를 적었습니다.", "nar"], [485.304, 488.1019999999999, "좋은 사람이란, 어떤 사람인가.", "mono"], [488.87199999999996, 492.1259999999999, "그것을 따지는 데, 남은 날을 쓰지 마라.", "mono"], [500.4400419999999, 503.7385199999999, "황제에게 철학은, 말이 아니라 행동이었습니다.", "nar"], [504.0779199999999, 509.4859999999999, "경매대에 오른 황후의 옷이, 그가 쓴 어떤 문장보다 그의 철학을 잘 보여 주었습니다.", "nar"], [510.4320419999999, 514.9752299999999, "매주 토요일, 무료 급식소에 말없이 나와 밥을 푸는 할아버지가 있습니다.", "nar"], [515.2136899999998, 517.2219999999999, "사진 한 장 남기지 않습니다.", "nar"], [517.753167, 520.2737848749999, "말보다 먼저, 손이 움직이는 사람.", "emph"], [520.0437848749999, 522.212, "그 사람이, 좋은 사람입니다.", "emph"], [525.9319999999999, 531.6339999999999, "그리고 전쟁이 끝난 뒤, 황제는 경매에서 물건을 산 사람들에게, 한 가지를 알렸습니다.", "nar"], [537.716188, 541.8722300000001, "원하는 사람은 물건을 돌려주고, 낸 돈을 다시 받아 가도 된다고.", "nar"], [542.15946, 546.226, "돌려주지 않는다고 해서, 아무도 벌하지 않았습니다.", "nar"], [546.889875, 550.11502, "누군가는 돌려주었고, 누군가는 간직했습니다.", "nar"], [550.2071, 554.118, "황제는 그 누구에게도, 고맙다는 말을 요구하지 않았습니다.", "nar"], [555.344229, 560.4545400000001, "그리고 오랜 세월이 흐른 뒤, 사람들은 그를 로마 오현제의 마지막 황제로 기억했습니다.", "nar"], [560.42188, 562.798, "그를 알아준 것은, 시간이었습니다.", "nar"], [563.968, 567.342, "나는 공동체를 위해, 무언가를 했는가.", "mono"], [568.112, 571.486, "그렇다면, 나는 이미 보상을 받았다.", "mono"], [579.182833, 582.02758, "황제는 보상을 바깥에서 찾지 않았습니다.", "nar"], [582.5149799999999, 586.8059999999999, "좋은 일을 한 순간, 그 사람은 이미 조금 더 좋은 사람이 되어 있다는 겁니다.", "nar"], [587.670583, 590.04671, "삼십 년 다닌 회사의 마지막 날.", "nar"], [590.29535, 595.046, "송별회는 짧았고, 누구도 내 이름을 오래 기억하지 않을 겁니다.", "nar"], [595.366, 599.388, "하지만 그 삼십 년이, 한 가족을 키웠습니다.", "emph"], [645.384, 649.5020000000001, "오늘 밤, 잠들기 전에, 이 세 가지만 해 보세요.", "nar"], [667.856, 672.166, "알아주는 사람이 없어도, 좋은 일은 이미 일어났습니다.", "emph"]]