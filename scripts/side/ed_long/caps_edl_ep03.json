[[1.02, 5.666, "“황후의 비단옷이오! 금실로 수놓은, 황후의 옷이오!”", "nar"], [6.334874999999999, 9.4355, "기원후 백육십구 년, 로마 트라야누스 광장.", "nar"], [9.90485, 13.298, "황제가, 궁전의 보물을 시장에 내놓았습니다.", "nar"], [13.879708, 17.1611, "황금 잔과 수정 그릇, 그리고 황후의 옷까지.", "nar"], [17.4124, 19.442, "사람들은 수군거렸습니다.", "nar"], [19.812000000000005, 24.122, "“철학에 빠진 황제가, 이제는 장사꾼이 되었군.”", "nar"], [24.892000000000003, 27.282, "아무도 알아주지 않을 것이다.", "mono"], [27.552000000000003, 29.822, "그래도, 나는 한다.", "emph"], [46.663313, 47.492708, "삼 년 전.", "nar"], [47.570600000000006, 51.954, "동방 원정을 마친 군대가, 승리의 행렬을 이루며 로마로 돌아왔습니다.", "nar"], [53.16577100000001, 56.67085, "그런데 그 행렬과 함께, 보이지 않는 손님이 따라 들어왔습니다.", "nar"], [56.64340000000001, 58.09, "역병이었습니다.", "nar"], [59.17125000000001, 64.96277, "훗날 안토니누스 역병이라 불린 이 병은, 제국 곳곳에서 수많은 목숨을 앗아 갔습니다.", "nar"], [65.15050000000001, 69.86600000000001, "의사 갈레노스는, 열병과 붉은 발진을 기록으로 남겼습니다.", "nar"], [70.63600000000001, 73.55400000000002, "황제는 로마를 떠나지 않았습니다.", "nar"], [79.58429200000002, 82.08754000000002, "시신은 수레에 실려 나갔습니다.", "nar"], [82.24346000000001, 86.08200000000002, "가난한 사람들에게는, 장례를 치를 돈조차 없었습니다.", "nar"], [86.352, 91.86200000000001, "황제는 나라의 돈으로, 가난한 이들의 장례를 치러 주게 했다고 전해집니다.", "nar"], [92.63200000000002, 102.10200000000002, "“우리 남편 장례를, 황제께서 치러 주셨대요. 그런데 그분 얼굴은, 한 번도 못 봤어요.”", "nar"], [102.37200000000001, 105.89000000000001, "황제는 그 일을, 어디에도 드러내지 않았습니다.", "nar"], [107.06, 112.018, "어떤 사람은 남에게 잘해 주고, 그 빚을 꼭 받아 내려 한다.", "mono"], [112.78800000000001, 117.98600000000002, "어떤 사람은 입으로는 말하지 않아도, 마음속에 장부를 적는다.", "mono"], [126.31241700000001, 131.10154000000003, "황제는 좋은 사람을, 포도를 맺고도 자랑하지 않는 포도나무에 비유했습니다.", "nar"], [131.40454, 137.098, "열매를 맺는 것이 포도나무의 본성이듯, 선을 행하는 것이 사람의 본성이라는 겁니다.", "nar"], [138.20416699999998, 140.4274, "삼십 년 동안 차려 온 저녁 밥상.", "nar"], [140.46506, 144.43400000000003, "고맙다는 말은 없는데, 내일도 밥은 차려야 합니다.", "nar"], [145.204, 149.87400000000002, "알아주는 사람이 없어도, 그 밥상은 가족을 살렸습니다.", "emph"], [161.076, 165.482, "그리고 그해 겨울, 황제에게 또 하나의 소식이 날아들었습니다.", "nar"], [171.25199999999998, 178.154, "북쪽 전선으로 함께 가던 길, 공동 황제이자 아우인 루키우스가, 마차 안에서 쓰러졌습니다.", "nar"], [179.18710399999998, 181.51570999999998, "루키우스는 끝내 일어나지 못했습니다.", "nar"], [181.70149999999998, 185.994, "황제는 아우를 신으로 모시는 장례를, 정성껏 치러 주었습니다.", "nar"], [186.76399999999998, 190.378, "그러나 로마에는, 이상한 소문이 돌았습니다.", "nar"], [190.64799999999997, 193.902, "“황제가, 자기 아우를 독살했다더군.”", "nar"], [194.17199999999997, 197.78599999999997, "황제는 그 소문에, 한마디도 답하지 않았습니다.", "nar"], [198.956, 202.45000000000002, "너는 선을 행했고, 그는 그 덕을 보았다.", "mono"], [203.21999999999997, 206.83399999999997, "그런데 왜, 바보처럼 세 번째 것을 찾는가.", "mono"], [216.09406199999998, 220.57296, "황제는 선을 행하는 일과, 그 일로 인정받는 일을 분명히 나누었습니다.", "nar"], [220.54137999999998, 224.266, "앞의 것은 내 몫이고, 뒤의 것은 남의 몫이라는 겁니다.", "nar"], [225.24774999999997, 228.03287, "십 년 동안 홀로 어머니 병간호를 했습니다.", "nar"], [228.42689999999996, 232.946, "그런데 장례식장에서, 친척들은 한마디씩 거들기만 했습니다.", "nar"], [233.71599999999998, 238.07399999999998, "내가 한 일은, 남이 알아줘야 완성되는 일이 아닙니다.", "emph"], [245.94, 249.842, "그해 봄, 제국의 금고가 바닥을 드러냈습니다.", "nar"], [255.871729, 260.2331, "역병으로 사람이 줄고, 북쪽에서는 게르만족이 국경을 넘어왔습니다.", "nar"], [260.65065000000004, 263.066, "그런데 군대를 꾸릴 돈이, 없었습니다.", "nar"], [263.836, 266.65799999999996, "원로원은 손쉬운 길을 말했습니다.", "nar"], [266.728, 269.54999999999995, "“세금을 더 걷으면 됩니다, 폐하.”", "nar"], [269.880354, 272.37014999999997, "그러나 황제는 고개를 저었습니다.", "nar"], [272.5505, 276.09, "그리고 아무도 예상하지 못한 결정을 내렸습니다.", "nar"], [276.46000000000004, 278.61, "“궁전의 것을, 팔겠소.”", "mono"], [279.78000000000003, 283.394, "죽은 뒤의 이름에 매달리는 사람은 잊는다.", "mono"], [284.16400000000004, 288.666, "그를 기억하는 사람들도, 곧 모두 떠난다는 것을.", "mono"], [295.727354, 298.03675, "세금을 올리면 쉬웠을 겁니다.", "nar"], [298.22733, 302.09162999999995, "하지만 그 짐은, 역병에 지친 백성이 졌을 겁니다.", "nar"], [302.43485, 306.794, "황제는 이름을 남기는 일보다, 오늘의 옳은 일을 앞에 두었습니다.", "nar"], [307.818667, 309.56192, "또 밀린 승진 발표날.", "nar"], [309.7029, 312.834, "밤새 만든 보고서는, 상사의 이름으로 올라갔습니다.", "nar"], [313.60400000000004, 317.41, "이름은 남이 가져가도, 그 일을 해낸 사람은 나입니다.", "emph"], [324.82000000000005, 329.442, "그렇게 트라야누스 광장에, 경매대가 세워졌습니다.", "nar"], [335.48943800000006, 338.00977, "경매는, 두 달 동안 이어졌다고 전해집니다.", "nar"], [338.18056000000007, 342.882, "황금 잔과 수정 그릇, 대대로 내려온 조각상까지 하나씩 팔려 나갔습니다.", "nar"], [343.861708, 345.30146, "사람들은 웃었습니다.", "nar"], [345.49460000000005, 347.10837, "황제가 체면을 잃었다고.", "nar"], [347.24812000000003, 349.618, "황후의 옷까지 내다 파는 황제라고.", "nar"], [349.68800000000005, 352.726, "“더 부르실 분 없소? 팔렸소!”", "nar"], [353.49600000000004, 359.006, "그렇게 모은 돈으로, 황제는 백성에게 세금을 더 걷지 않고 군대를 꾸렸습니다.", "nar"], [360.17600000000004, 365.326, "추울 때든 따뜻할 때든, 졸릴 때든 푹 잤을 때든.", "mono"], [366.09600000000006, 368.87, "칭찬을 듣든, 비난을 듣든.", "mono"], [376.300583, 379.3134, "스토아 철학자들은 이것을, 의무라고 불렀습니다.", "nar"], [379.8686, 383.71, "남의 박수와 상관없이, 내 자리에서 마땅히 할 일입니다.", "nar"], [384.685667, 387.3576, "새벽 세 시, 아무도 보지 않는 병동.", "nar"], [387.31292, 390.27799999999996, "간호사는 잠든 환자의 이불을, 다시 덮어 줍니다.", "nar"], [391.048, 395.50199999999995, "아무도 보지 않는 일이, 세상을 굴러가게 합니다.", "emph"], [403.46079199999997, 405.46493999999996, "몇 해 뒤, 다뉴브 전선.", "nar"], [405.59012, 409.40599999999995, "큰 승리를 거둔 병사들이, 황제 앞에 모여들었습니다.", "nar"], [415.61420799999996, 417.56622999999996, "병사들은 상여금을 요구했습니다.", "nar"], [417.68665, 421.14199999999994, "목숨을 걸고 싸웠으니, 그만한 상을 달라는 것이었습니다.", "nar"], [421.212, 427.36999999999995, "“폐하, 우리는 피를 흘렸습니다. 그에 맞는 상을 주십시오.”", "nar"], [428.35275, 429.91176999999993, "황제는 거절했습니다.", "nar"], [430.04498, 432.40199999999993, "그리고 이렇게 말했다고 전해집니다.", "nar"], [432.472, 438.48599999999993, "“그대들에게 더 주는 것은, 그대들 부모와 형제의 피에서 짜내는 것이오.”", "mono"], [438.79443699999996, 440.32162999999997, "병사들은 투덜거렸습니다.", "nar"], [440.46385, 443.75399999999996, "인기를 얻기 쉬운 길을, 황제는 또 마다한 것입니다.", "nar"], [444.92400000000004, 448.418, "사람은 누구보다 자기를 사랑하면서도,", "mono"], [449.18800000000005, 453.81, "자기 생각보다, 남의 생각을 더 무겁게 여긴다.", "mono"], [460.895687, 463.25649999999996, "황제에게 인기는 목표가 아니었습니다.", "nar"], [463.30198, 467.594, "옳다고 판단한 일이 인기가 없을 때, 그는 판단 쪽을 택했습니다.", "nar"], [468.83970800000003, 471.71879, "우리 반에서 나만 휴대폰이 없다는 아이의 말.", "nar"], [471.64004000000006, 474.93, "엄마의 마음은, 하루에도 몇 번씩 흔들립니다.", "nar"], [475.70000000000005, 479.218, "미움받는 결정이, 틀린 결정은 아닙니다.", "emph"], [486.72400000000005, 491.538, "그날 밤, 막사에서 황제는, 자신을 비웃는 말들을 떠올렸습니다.", "nar"], [497.57339600000006, 501.77712, "로마에는 그를, 철학자 황제라고 비꼬는 사람들이 있었습니다.", "nar"], [502.45110000000005, 505.122, "책을 붙들고 생각만 하는 황제라고.", "nar"], [505.89200000000005, 510.562, "그러나 그날 밤 일기에, 황제는 다른 이야기를 적었습니다.", "nar"], [511.7320000000001, 514.5300000000001, "좋은 사람이란, 어떤 사람인가.", "mono"], [515.3000000000001, 518.5540000000001, "그것을 따지는 데, 남은 날을 쓰지 마라.", "mono"], [526.868042, 530.16652, "황제에게 철학은, 말이 아니라 행동이었습니다.", "nar"], [530.50592, 535.914, "경매대에 오른 황후의 옷이, 그가 쓴 어떤 문장보다 그의 철학을 잘 보여 주었습니다.", "nar"], [537.060042, 541.6032299999999, "매주 토요일, 무료 급식소에 말없이 나와 밥을 푸는 할아버지가 있습니다.", "nar"], [541.84169, 543.85, "사진 한 장 남기지 않습니다.", "nar"], [544.831167, 547.351784875, "말보다 먼저, 손이 움직이는 사람.", "emph"], [547.121784875, 549.2900000000001, "그 사람이, 좋은 사람입니다.", "emph"], [557.6360000000001, 563.3380000000001, "그리고 전쟁이 끝난 뒤, 황제는 경매에서 물건을 산 사람들에게, 한 가지를 알렸습니다.", "nar"], [569.4201880000002, 573.5762300000002, "원하는 사람은 물건을 돌려주고, 낸 돈을 다시 받아 가도 된다고.", "nar"], [573.8634600000001, 577.9300000000002, "돌려주지 않는다고 해서, 아무도 벌하지 않았습니다.", "nar"], [578.5938750000001, 581.8190200000001, "누군가는 돌려주었고, 누군가는 간직했습니다.", "nar"], [581.9111000000001, 585.8220000000002, "황제는 그 누구에게도, 고맙다는 말을 요구하지 않았습니다.", "nar"], [587.0482290000002, 592.1585400000002, "그리고 오랜 세월이 흐른 뒤, 사람들은 그를 로마 오현제의 마지막 황제로 기억했습니다.", "nar"], [592.1258800000002, 594.5020000000002, "그를 알아준 것은, 시간이었습니다.", "nar"], [595.6720000000001, 599.0460000000002, "나는 공동체를 위해, 무언가를 했는가.", "mono"], [599.8160000000001, 603.1900000000002, "그렇다면, 나는 이미 보상을 받았다.", "mono"], [610.8868330000001, 613.7315800000001, "황제는 보상을 바깥에서 찾지 않았습니다.", "nar"], [614.2189800000001, 618.5100000000001, "좋은 일을 한 순간, 그 사람은 이미 조금 더 좋은 사람이 되어 있다는 겁니다.", "nar"], [619.5745830000001, 621.9507100000001, "삼십 년 다닌 회사의 마지막 날.", "nar"], [622.1993500000001, 626.9500000000002, "송별회는 짧았고, 누구도 내 이름을 오래 기억하지 않을 겁니다.", "nar"], [627.7200000000001, 631.7420000000002, "하지만 그 삼십 년이, 한 가족을 키웠습니다.", "emph"], [681.6160000000002, 685.9260000000003, "알아주는 사람이 없어도, 좋은 일은 이미 일어났습니다.", "emph"]]