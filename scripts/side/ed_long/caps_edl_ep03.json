[[1.02, 5.666, "“황후의 비단옷이오! 금실로 수놓은, 황후의 옷이오!”", "nar", null], [6.134875, 9.2355, "기원후 백육십구 년, 로마 트라야누스 광장.", "nar", null], [9.70485, 13.098, "황제가, 궁전의 보물을 시장에 내놓았습니다.", "nar", null], [13.679708, 16.9611, "황금 잔과 수정 그릇, 그리고 황후의 옷까지.", "nar", null], [17.212400000000002, 19.241999999999997, "사람들은 수군거렸습니다.", "nar", null], [19.612000000000002, 23.921999999999997, "“철학에 빠진 황제가, 이제는 장사꾼이 되었군.”", "nar", null], [24.692, 27.081999999999997, "아무도 알아주지 않을 것이다.", "mono", null], [27.352, 29.621999999999996, "그래도, 나는 한다.", "emph", null], [46.463313, 47.292708, "삼 년 전.", "nar", null], [47.3706, 51.754, "동방 원정을 마친 군대가, 승리의 행렬을 이루며 로마로 돌아왔습니다.", "nar", null], [52.965771000000004, 56.47085, "그런데 그 행렬과 함께, 보이지 않는 손님이 따라 들어왔습니다.", "nar", null], [56.443400000000004, 57.89, "역병이었습니다.", "nar", null], [58.971250000000005, 64.76277, "훗날 안토니누스 역병이라 불린 이 병은, 제국 곳곳에서 수많은 목숨을 앗아 갔습니다.", "nar", null], [64.9505, 69.66600000000001, "의사 갈레노스는, 열병과 붉은 발진을 기록으로 남겼습니다.", "nar", null], [70.436, 73.35400000000001, "황제는 로마를 떠나지 않았습니다.", "nar", null], [79.38429200000002, 81.88754000000002, "시신은 수레에 실려 나갔습니다.", "nar", null], [82.04346000000001, 85.88200000000002, "가난한 사람들에게는, 장례를 치를 돈조차 없었습니다.", "nar", null], [86.152, 91.662, "황제는 나라의 돈으로, 가난한 이들의 장례를 치러 주게 했다고 전해집니다.", "nar", null], [92.432, 101.902, "“우리 남편 장례를, 황제께서 치러 주셨대요. 그런데 그분 얼굴은, 한 번도 못 봤어요.”", "nar", null], [102.172, 105.69, "황제는 그 일을, 어디에도 드러내지 않았습니다.", "nar", null], [106.85999999999999, 111.81799999999998, "어떤 사람은 남에게 잘해 주고, 그 빚을 꼭 받아 내려 한다.", "mono", null], [112.588, 117.786, "어떤 사람은 입으로는 말하지 않아도, 마음속에 장부를 적는다.", "mono", null], [126.112417, 130.90154, "황제는 좋은 사람을, 포도를 맺고도 자랑하지 않는 포도나무에 비유했습니다.", "nar", null], [131.20453999999998, 136.898, "열매를 맺는 것이 포도나무의 본성이듯, 선을 행하는 것이 사람의 본성이라는 겁니다.", "nar", null], [137.80416699999995, 140.02739999999997, "삼십 년 동안 차려 온 저녁 밥상.", "nar", null], [140.06505999999996, 144.034, "고맙다는 말은 없는데, 내일도 밥은 차려야 합니다.", "nar", null], [144.35399999999996, 149.02399999999997, "알아주는 사람이 없어도, 그 밥상은 가족을 살렸습니다.", "emph", [144.66312499999998, 146.59222999999997]], [152.74399999999997, 157.14999999999998, "그리고 그해 겨울, 황제에게 또 하나의 소식이 날아들었습니다.", "nar", null], [162.91999999999996, 169.82199999999997, "북쪽 전선으로 함께 가던 길, 공동 황제이자 아우인 루키우스가, 마차 안에서 쓰러졌습니다.", "nar", null], [170.85510399999995, 173.18370999999996, "루키우스는 끝내 일어나지 못했습니다.", "nar", null], [173.36949999999996, 177.66199999999998, "황제는 아우를 신으로 모시는 장례를, 정성껏 치러 주었습니다.", "nar", null], [178.43199999999996, 182.04599999999996, "그러나 로마에는, 이상한 소문이 돌았습니다.", "nar", null], [182.31599999999995, 185.56999999999996, "“황제가, 자기 아우를 독살했다더군.”", "nar", null], [185.83999999999995, 189.45399999999995, "황제는 그 소문에, 한마디도 답하지 않았습니다.", "nar", null], [190.62399999999997, 194.118, "너는 선을 행했고, 그는 그 덕을 보았다.", "mono", null], [194.88799999999995, 198.50199999999995, "그런데 왜, 바보처럼 세 번째 것을 찾는가.", "mono", null], [207.762062, 212.24096, "황제는 선을 행하는 일과, 그 일로 인정받는 일을 분명히 나누었습니다.", "nar", null], [212.20937999999998, 215.934, "앞의 것은 내 몫이고, 뒤의 것은 남의 몫이라는 겁니다.", "nar", null], [216.71574999999996, 219.50087, "십 년 동안 홀로 어머니 병간호를 했습니다.", "nar", null], [219.89489999999995, 224.414, "그런데 장례식장에서, 친척들은 한마디씩 거들기만 했습니다.", "nar", null], [224.73399999999995, 229.09199999999996, "내가 한 일은, 남이 알아줘야 완성되는 일이 아닙니다.", "emph", [225.00199999999998, 226.31436999999997]], [232.81199999999995, 236.71399999999997, "그해 봄, 제국의 금고가 바닥을 드러냈습니다.", "nar", null], [242.74372899999995, 247.10509999999996, "역병으로 사람이 줄고, 북쪽에서는 게르만족이 국경을 넘어왔습니다.", "nar", null], [247.52264999999994, 249.93799999999996, "그런데 군대를 꾸릴 돈이, 없었습니다.", "nar", null], [250.70799999999994, 253.52999999999997, "원로원은 손쉬운 길을 말했습니다.", "nar", null], [253.59999999999994, 256.4219999999999, "“세금을 더 걷으면 됩니다, 폐하.”", "nar", null], [256.75235399999997, 259.2421499999999, "그러나 황제는 고개를 저었습니다.", "nar", null], [259.42249999999996, 262.96199999999993, "그리고 아무도 예상하지 못한 결정을 내렸습니다.", "nar", null], [263.332, 265.48199999999997, "“궁전의 것을, 팔겠소.”", "mono", null], [266.652, 270.26599999999996, "죽은 뒤의 이름에 매달리는 사람은 잊는다.", "mono", null], [271.036, 275.53799999999995, "그를 기억하는 사람들도, 곧 모두 떠난다는 것을.", "mono", null], [282.59935399999995, 284.90874999999994, "세금을 올리면 쉬웠을 겁니다.", "nar", null], [285.09932999999995, 288.9636299999999, "하지만 그 짐은, 역병에 지친 백성이 졌을 겁니다.", "nar", null], [289.30684999999994, 293.66599999999994, "황제는 이름을 남기는 일보다, 오늘의 옳은 일을 앞에 두었습니다.", "nar", null], [294.490667, 296.23391999999996, "또 밀린 승진 발표날.", "nar", null], [296.37489999999997, 299.506, "밤새 만든 보고서는, 상사의 이름으로 올라갔습니다.", "nar", null], [299.82599999999996, 303.63199999999995, "이름은 남이 가져가도, 그 일을 해낸 사람은 나입니다.", "emph", [299.99212499999993, 301.53768999999994]], [307.3519999999999, 311.9739999999999, "그렇게 트라야누스 광장에, 경매대가 세워졌습니다.", "nar", null], [318.02143799999993, 320.5417699999999, "경매는, 두 달 동안 이어졌다고 전해집니다.", "nar", null], [320.71255999999994, 325.4139999999999, "황금 잔과 수정 그릇, 대대로 내려온 조각상까지 하나씩 팔려 나갔습니다.", "nar", null], [326.3937079999999, 327.8334599999999, "사람들은 웃었습니다.", "nar", null], [328.0265999999999, 329.64036999999985, "황제가 체면을 잃었다고.", "nar", null], [329.7801199999999, 332.14999999999986, "황후의 옷까지 내다 파는 황제라고.", "nar", null], [332.2199999999999, 335.25799999999987, "“더 부르실 분 없소? 팔렸소!”", "nar", null], [336.0279999999999, 341.53799999999984, "그렇게 모은 돈으로, 황제는 백성에게 세금을 더 걷지 않고 군대를 꾸렸습니다.", "nar", null], [342.7079999999999, 347.8579999999999, "추울 때든 따뜻할 때든, 졸릴 때든 푹 잤을 때든.", "mono", null], [348.62799999999993, 351.4019999999999, "칭찬을 듣든, 비난을 듣든.", "mono", null], [358.8325829999999, 361.84539999999987, "스토아 철학자들은 이것을, 의무라고 불렀습니다.", "nar", null], [362.4005999999999, 366.24199999999985, "남의 박수와 상관없이, 내 자리에서 마땅히 할 일입니다.", "nar", null], [367.0176669999999, 369.68959999999987, "새벽 세 시, 아무도 보지 않는 병동.", "nar", null], [369.6449199999999, 372.60999999999984, "간호사는 잠든 환자의 이불을, 다시 덮어 줍니다.", "nar", null], [372.9299999999999, 377.38399999999984, "아무도 보지 않는 일이, 세상을 굴러가게 합니다.", "emph", [373.35868699999986, 375.1469931578946]], [381.26879199999985, 383.27293999999983, "몇 해 뒤, 다뉴브 전선.", "nar", null], [383.3981199999999, 387.2139999999998, "큰 승리를 거둔 병사들이, 황제 앞에 모여들었습니다.", "nar", null], [393.42220799999984, 395.37422999999984, "병사들은 상여금을 요구했습니다.", "nar", null], [395.49464999999987, 398.9499999999998, "목숨을 걸고 싸웠으니, 그만한 상을 달라는 것이었습니다.", "nar", null], [399.01999999999987, 405.1779999999998, "“폐하, 우리는 피를 흘렸습니다. 그에 맞는 상을 주십시오.”", "nar", null], [406.1607499999999, 407.7197699999998, "황제는 거절했습니다.", "nar", null], [407.8529799999999, 410.2099999999998, "그리고 이렇게 말했다고 전해집니다.", "nar", null], [410.27999999999986, 416.2939999999998, "“그대들에게 더 주는 것은, 그대들 부모와 형제의 피에서 짜내는 것이오.”", "mono", null], [416.60243699999984, 418.12962999999985, "병사들은 투덜거렸습니다.", "nar", null], [418.27184999999986, 421.56199999999984, "인기를 얻기 쉬운 길을, 황제는 또 마다한 것입니다.", "nar", null], [422.7319999999999, 426.2259999999999, "사람은 누구보다 자기를 사랑하면서도,", "mono", null], [426.9959999999999, 431.6179999999999, "자기 생각보다, 남의 생각을 더 무겁게 여긴다.", "mono", null], [438.7036869999999, 441.06449999999984, "황제에게 인기는 목표가 아니었습니다.", "nar", null], [441.1099799999999, 445.4019999999999, "옳다고 판단한 일이 인기가 없을 때, 그는 판단 쪽을 택했습니다.", "nar", null], [446.4477079999999, 449.3267899999999, "우리 반에서 나만 휴대폰이 없다는 아이의 말.", "nar", null], [449.24803999999995, 452.5379999999999, "엄마의 마음은, 하루에도 몇 번씩 흔들립니다.", "nar", null], [452.85799999999995, 456.3759999999999, "미움받는 결정이, 틀린 결정은 아닙니다.", "emph", null], [460.09599999999995, 464.9099999999999, "그날 밤, 막사에서 황제는, 자신을 비웃는 말들을 떠올렸습니다.", "nar", null], [470.94539599999996, 475.1491199999999, "로마에는 그를, 철학자 황제라고 비꼬는 사람들이 있었습니다.", "nar", null], [475.82309999999995, 478.4939999999999, "책을 붙들고 생각만 하는 황제라고.", "nar", null], [479.26399999999995, 483.9339999999999, "그러나 그날 밤 일기에, 황제는 다른 이야기를 적었습니다.", "nar", null], [485.104, 487.90199999999993, "좋은 사람이란, 어떤 사람인가.", "mono", null], [488.67199999999997, 491.92599999999993, "그것을 따지는 데, 남은 날을 쓰지 마라.", "mono", null], [500.24004199999996, 503.53851999999995, "황제에게 철학은, 말이 아니라 행동이었습니다.", "nar", null], [503.87791999999996, 509.28599999999994, "경매대에 오른 황후의 옷이, 그가 쓴 어떤 문장보다 그의 철학을 잘 보여 주었습니다.", "nar", null], [510.232042, 514.77523, "매주 토요일, 무료 급식소에 말없이 나와 밥을 푸는 할아버지가 있습니다.", "nar", null], [515.0136899999999, 517.0219999999999, "사진 한 장 남기지 않습니다.", "nar", null], [517.553167, 520.073784875, "말보다 먼저, 손이 움직이는 사람.", "emph", null], [519.843784875, 522.0120000000001, "그 사람이, 좋은 사람입니다.", "emph", null], [525.732, 531.434, "그리고 전쟁이 끝난 뒤, 황제는 경매에서 물건을 산 사람들에게, 한 가지를 알렸습니다.", "nar", null], [537.516188, 541.6722300000001, "원하는 사람은 물건을 돌려주고, 낸 돈을 다시 받아 가도 된다고.", "nar", null], [541.95946, 546.0260000000001, "돌려주지 않는다고 해서, 아무도 벌하지 않았습니다.", "nar", null], [546.689875, 549.91502, "누군가는 돌려주었고, 누군가는 간직했습니다.", "nar", null], [550.0071, 553.9180000000001, "황제는 그 누구에게도, 고맙다는 말을 요구하지 않았습니다.", "nar", null], [555.1442290000001, 560.2545400000001, "그리고 오랜 세월이 흐른 뒤, 사람들은 그를 로마 오현제의 마지막 황제로 기억했습니다.", "nar", null], [560.22188, 562.5980000000001, "그를 알아준 것은, 시간이었습니다.", "nar", null], [563.768, 567.142, "나는 공동체를 위해, 무언가를 했는가.", "mono", null], [567.912, 571.2860000000001, "그렇다면, 나는 이미 보상을 받았다.", "mono", null], [578.982833, 581.82758, "황제는 보상을 바깥에서 찾지 않았습니다.", "nar", null], [582.31498, 586.606, "좋은 일을 한 순간, 그 사람은 이미 조금 더 좋은 사람이 되어 있다는 겁니다.", "nar", null], [587.470583, 589.84671, "삼십 년 다닌 회사의 마지막 날.", "nar", null], [590.09535, 594.8460000000001, "송별회는 짧았고, 누구도 내 이름을 오래 기억하지 않을 겁니다.", "nar", null], [595.166, 599.1880000000001, "하지만 그 삼십 년이, 한 가족을 키웠습니다.", "emph", null], [613.04, 617.158, "오늘 밤, 잠들기 전에, 이 세 가지만 해 보세요.", "nar", null], [623.928, 628.238, "알아주는 사람이 없어도, 좋은 일은 이미 일어났습니다.", "emph", [624.3451670000001, 626.04921]]]