[[1.02, 4.994000000000001, "“황후의 비단옷이오! 금실로 수놓은, 황후의 옷이오!”", "nar"], [5.662875, 8.7635, "기원후 백육십구 년, 로마 트라야누스 광장.", "nar"], [9.232850000000001, 12.626, "황제가, 궁전의 보물을 시장에 내놓았습니다.", "nar"], [13.207708, 16.4891, "황금 잔과 수정 그릇, 그리고 황후의 옷까지.", "nar"], [16.7404, 18.77, "사람들은 수군거렸습니다.", "nar"], [19.140000000000004, 23.450000000000003, "“철학에 빠진 황제가, 이제는 장사꾼이 되었군.”", "nar"], [24.220000000000002, 26.61, "아무도 알아주지 않을 것이다.", "mono"], [26.880000000000003, 29.15, "그래도, 나는 한다.", "emph"], [45.991313, 46.820707999999996, "삼 년 전.", "nar"], [46.8986, 51.282, "동방 원정을 마친 군대가, 승리의 행렬을 이루며 로마로 돌아왔습니다.", "nar"], [52.493771, 55.99885, "그런데 그 행렬과 함께, 보이지 않는 손님이 따라 들어왔습니다.", "nar"], [55.9714, 57.418, "역병이었습니다.", "nar"], [58.49925, 64.29077000000001, "훗날 안토니누스 역병이라 불린 이 병은, 제국 곳곳에서 수많은 목숨을 앗아 갔습니다.", "nar"], [64.4785, 69.194, "의사 갈레노스는, 열병과 붉은 발진을 기록으로 남겼습니다.", "nar"], [69.96400000000001, 72.88200000000002, "황제는 로마를 떠나지 않았습니다.", "nar"], [78.91229200000002, 81.41554000000002, "시신은 수레에 실려 나갔습니다.", "nar"], [81.57146000000002, 85.41000000000003, "가난한 사람들에게는, 장례를 치를 돈조차 없었습니다.", "nar"], [85.68, 91.19000000000001, "황제는 나라의 돈으로, 가난한 이들의 장례를 치러 주게 했다고 전해집니다.", "nar"], [91.96000000000002, 101.43000000000002, "“우리 남편 장례를, 황제께서 치러 주셨대요. 그런데 그분 얼굴은, 한 번도 못 봤어요.”", "nar"], [101.70000000000002, 105.21800000000002, "황제는 그 일을, 어디에도 드러내지 않았습니다.", "nar"], [106.388, 111.346, "어떤 사람은 남에게 잘해 주고, 그 빚을 꼭 받아 내려 한다.", "mono"], [112.11600000000001, 117.31400000000002, "어떤 사람은 입으로는 말하지 않아도, 마음속에 장부를 적는다.", "mono"], [125.64041700000001, 130.42954000000003, "황제는 좋은 사람을, 포도를 맺고도 자랑하지 않는 포도나무에 비유했습니다.", "nar"], [130.73254, 136.42600000000002, "열매를 맺는 것이 포도나무의 본성이듯, 선을 행하는 것이 사람의 본성이라는 겁니다.", "nar"], [137.532167, 139.7554, "삼십 년 동안 차려 온 저녁 밥상.", "nar"], [139.79306, 143.76200000000003, "고맙다는 말은 없는데, 내일도 밥은 차려야 합니다.", "nar"], [144.532, 149.20200000000003, "알아주는 사람이 없어도, 그 밥상은 가족을 살렸습니다.", "emph"], [160.404, 164.81, "그리고 그해 겨울, 황제에게 또 하나의 소식이 날아들었습니다.", "nar"], [170.57999999999998, 177.482, "북쪽 전선으로 함께 가던 길, 공동 황제이자 아우인 루키우스가, 마차 안에서 쓰러졌습니다.", "nar"], [178.51510399999998, 180.84371, "루키우스는 끝내 일어나지 못했습니다.", "nar"], [181.02949999999998, 185.322, "황제는 아우를 신으로 모시는 장례를, 정성껏 치러 주었습니다.", "nar"], [186.09199999999998, 189.706, "그러나 로마에는, 이상한 소문이 돌았습니다.", "nar"], [189.97599999999997, 193.23, "“황제가, 자기 아우를 독살했다더군.”", "nar"], [193.49999999999997, 197.11399999999998, "황제는 그 소문에, 한마디도 답하지 않았습니다.", "nar"], [198.284, 201.77800000000002, "너는 선을 행했고, 그는 그 덕을 보았다.", "mono"], [202.54799999999997, 206.16199999999998, "그런데 왜, 바보처럼 세 번째 것을 찾는가.", "mono"], [215.422062, 219.90096000000003, "황제는 선을 행하는 일과, 그 일로 인정받는 일을 분명히 나누었습니다.", "nar"], [219.86938, 223.59400000000002, "앞의 것은 내 몫이고, 뒤의 것은 남의 몫이라는 겁니다.", "nar"], [224.57575, 227.36087000000003, "십 년 동안 홀로 어머니 병간호를 했습니다.", "nar"], [227.7549, 232.27400000000003, "그런데 장례식장에서, 친척들은 한마디씩 거들기만 했습니다.", "nar"], [233.044, 237.40200000000002, "내가 한 일은, 남이 알아줘야 완성되는 일이 아닙니다.", "emph"], [245.26800000000003, 249.17000000000004, "그해 봄, 제국의 금고가 바닥을 드러냈습니다.", "nar"], [255.19972900000002, 259.5611, "역병으로 사람이 줄고, 북쪽에서는 게르만족이 국경을 넘어왔습니다.", "nar"], [259.9786500000001, 262.394, "그런데 군대를 꾸릴 돈이, 없었습니다.", "nar"], [263.16400000000004, 265.986, "원로원은 손쉬운 길을 말했습니다.", "nar"], [266.25600000000003, 269.078, "“세금을 더 걷으면 됩니다, 폐하.”", "nar"], [269.70835400000004, 272.19815, "그러나 황제는 고개를 저었습니다.", "nar"], [272.37850000000003, 275.918, "그리고 아무도 예상하지 못한 결정을 내렸습니다.", "nar"], [276.28800000000007, 278.43800000000005, "“궁전의 것을, 팔겠소.”", "mono"], [279.60800000000006, 283.22200000000004, "죽은 뒤의 이름에 매달리는 사람은 잊는다.", "mono"], [283.9920000000001, 288.494, "그를 기억하는 사람들도, 곧 모두 떠난다는 것을.", "mono"], [295.555354, 297.86475, "세금을 올리면 쉬웠을 겁니다.", "nar"], [298.05533, 301.91963, "하지만 그 짐은, 역병에 지친 백성이 졌을 겁니다.", "nar"], [302.26285, 306.622, "황제는 이름을 남기는 일보다, 오늘의 옳은 일을 앞에 두었습니다.", "nar"], [307.64666700000004, 309.38992, "또 밀린 승진 발표날.", "nar"], [309.53090000000003, 312.66200000000003, "밤새 만든 보고서는, 상사의 이름으로 올라갔습니다.", "nar"], [313.4320000000001, 317.23800000000006, "이름은 남이 가져가도, 그 일을 해낸 사람은 나입니다.", "emph"], [324.6480000000001, 329.27000000000004, "그렇게 트라야누스 광장에, 경매대가 세워졌습니다.", "nar"], [335.3174380000001, 337.83777000000003, "경매는, 두 달 동안 이어졌다고 전해집니다.", "nar"], [338.0085600000001, 342.71000000000004, "황금 잔과 수정 그릇, 대대로 내려온 조각상까지 하나씩 팔려 나갔습니다.", "nar"], [343.68970800000005, 345.12946000000005, "사람들은 웃었습니다.", "nar"], [345.3226000000001, 346.93637, "황제가 체면을 잃었다고.", "nar"], [347.07612000000006, 349.446, "황후의 옷까지 내다 파는 황제라고.", "nar"], [349.6160000000001, 352.39000000000004, "“더 부르실 분 없소? 팔렸소!”", "nar"], [353.1600000000001, 358.67, "그렇게 모은 돈으로, 황제는 백성에게 세금을 더 걷지 않고 군대를 꾸렸습니다.", "nar"], [359.8400000000001, 364.99000000000007, "추울 때든 따뜻할 때든, 졸릴 때든 푹 잤을 때든.", "mono"], [365.7600000000001, 368.53400000000005, "칭찬을 듣든, 비난을 듣든.", "mono"], [375.96458300000006, 378.97740000000005, "스토아 철학자들은 이것을, 의무라고 불렀습니다.", "nar"], [379.53260000000006, 383.374, "남의 박수와 상관없이, 내 자리에서 마땅히 할 일입니다.", "nar"], [384.34966700000007, 387.02160000000003, "새벽 세 시, 아무도 보지 않는 병동.", "nar"], [386.97692000000006, 389.942, "간호사는 잠든 환자의 이불을, 다시 덮어 줍니다.", "nar"], [390.71200000000005, 395.166, "아무도 보지 않는 일이, 세상을 굴러가게 합니다.", "emph"], [403.124792, 405.12894, "몇 해 뒤, 다뉴브 전선.", "nar"], [405.25412000000006, 409.07, "큰 승리를 거둔 병사들이, 황제 앞에 모여들었습니다.", "nar"], [415.278208, 417.23023, "병사들은 상여금을 요구했습니다.", "nar"], [417.35065000000003, 420.806, "목숨을 걸고 싸웠으니, 그만한 상을 달라는 것이었습니다.", "nar"], [421.0760000000001, 427.23400000000004, "“폐하, 우리는 피를 흘렸습니다. 그에 맞는 상을 주십시오.”", "nar"], [428.21675000000005, 429.77576999999997, "황제는 거절했습니다.", "nar"], [429.90898000000004, 432.26599999999996, "그리고 이렇게 말했다고 전해집니다.", "nar"], [432.53600000000006, 438.55, "“그대들에게 더 주는 것은, 그대들 부모와 형제의 피에서 짜내는 것이오.”", "mono"], [439.15843700000005, 440.68563000000006, "병사들은 투덜거렸습니다.", "nar"], [440.82785000000007, 444.11800000000005, "인기를 얻기 쉬운 길을, 황제는 또 마다한 것입니다.", "nar"], [445.28800000000007, 448.78200000000004, "사람은 누구보다 자기를 사랑하면서도,", "mono"], [449.5520000000001, 454.17400000000004, "자기 생각보다, 남의 생각을 더 무겁게 여긴다.", "mono"], [461.25968700000004, 463.6205, "황제에게 인기는 목표가 아니었습니다.", "nar"], [463.66598000000005, 467.958, "옳다고 판단한 일이 인기가 없을 때, 그는 판단 쪽을 택했습니다.", "nar"], [469.20370800000006, 472.08279000000005, "우리 반에서 나만 휴대폰이 없다는 아이의 말.", "nar"], [472.0040400000001, 475.29400000000004, "엄마의 마음은, 하루에도 몇 번씩 흔들립니다.", "nar"], [476.0640000000001, 479.58200000000005, "미움받는 결정이, 틀린 결정은 아닙니다.", "emph"], [487.0880000000001, 491.90200000000004, "그날 밤, 막사에서 황제는, 자신을 비웃는 말들을 떠올렸습니다.", "nar"], [497.9373960000001, 502.14112000000006, "로마에는 그를, 철학자 황제라고 비꼬는 사람들이 있었습니다.", "nar"], [502.8151000000001, 505.48600000000005, "책을 붙들고 생각만 하는 황제라고.", "nar"], [506.2560000000001, 510.92600000000004, "그러나 그날 밤 일기에, 황제는 다른 이야기를 적었습니다.", "nar"], [512.096, 514.894, "좋은 사람이란, 어떤 사람인가.", "mono"], [515.6640000000001, 518.9180000000001, "그것을 따지는 데, 남은 날을 쓰지 마라.", "mono"], [527.232042, 530.53052, "황제에게 철학은, 말이 아니라 행동이었습니다.", "nar"], [530.86992, 536.278, "경매대에 오른 황후의 옷이, 그가 쓴 어떤 문장보다 그의 철학을 잘 보여 주었습니다.", "nar"], [537.424042, 541.96723, "매주 토요일, 무료 급식소에 말없이 나와 밥을 푸는 할아버지가 있습니다.", "nar"], [542.20569, 544.214, "사진 한 장 남기지 않습니다.", "nar"], [545.1951670000001, 547.715784875, "말보다 먼저, 손이 움직이는 사람.", "emph"], [547.485784875, 549.6540000000001, "그 사람이, 좋은 사람입니다.", "emph"], [558.0000000000001, 563.7020000000001, "그리고 전쟁이 끝난 뒤, 황제는 경매에서 물건을 산 사람들에게, 한 가지를 알렸습니다.", "nar"], [569.7841880000002, 573.9402300000003, "원하는 사람은 물건을 돌려주고, 낸 돈을 다시 받아 가도 된다고.", "nar"], [574.2274600000002, 578.2940000000002, "돌려주지 않는다고 해서, 아무도 벌하지 않았습니다.", "nar"], [578.9578750000002, 582.1830200000002, "누군가는 돌려주었고, 누군가는 간직했습니다.", "nar"], [582.2751000000002, 586.1860000000003, "황제는 그 누구에게도, 고맙다는 말을 요구하지 않았습니다.", "nar"], [587.4122290000003, 592.5225400000003, "그리고 오랜 세월이 흐른 뒤, 사람들은 그를 로마 오현제의 마지막 황제로 기억했습니다.", "nar"], [592.4898800000002, 594.8660000000002, "그를 알아준 것은, 시간이었습니다.", "nar"], [596.0360000000002, 599.4100000000002, "나는 공동체를 위해, 무언가를 했는가.", "mono"], [600.1800000000002, 603.5540000000002, "그렇다면, 나는 이미 보상을 받았다.", "mono"], [611.2508330000002, 614.0955800000002, "황제는 보상을 바깥에서 찾지 않았습니다.", "nar"], [614.5829800000001, 618.8740000000001, "좋은 일을 한 순간, 그 사람은 이미 조금 더 좋은 사람이 되어 있다는 겁니다.", "nar"], [619.9385830000001, 622.3147100000001, "삼십 년 다닌 회사의 마지막 날.", "nar"], [622.5633500000001, 627.3140000000002, "송별회는 짧았고, 누구도 내 이름을 오래 기억하지 않을 겁니다.", "nar"], [628.0840000000002, 632.1060000000002, "하지만 그 삼십 년이, 한 가족을 키웠습니다.", "emph"], [681.9800000000002, 686.2900000000003, "알아주는 사람이 없어도, 좋은 일은 이미 일어났습니다.", "emph"]]