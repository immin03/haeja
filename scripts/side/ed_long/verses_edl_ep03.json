[{"t0": 118.636, "t1": 125.724, "lines": ["포도나무가 포도를 맺듯,", "선을 행하고 아무것도 바라지 마라."], "src": "명상록 5권 6절"}, {"t0": 199.352, "t1": 207.25599999999997, "lines": ["선을 행했으면 그것으로 끝이다,", "세 번째 것을 바라지 마라."], "src": "명상록 7권 73절"}, {"t0": 276.388, "t1": 282.17999999999995, "lines": ["이름은 금방 잊힌다,", "지금, 옳은 일을 하라."], "src": "명상록 4권 19절"}, {"t0": 352.2519999999999, "t1": 358.4519999999999, "lines": ["칭찬을 듣든 비난을 듣든,", "해야 할 일을 하라."], "src": "명상록 6권 2절"}, {"t0": 432.4679999999999, "t1": 438.3799999999999, "lines": ["남의 평가를,", "내 판단보다 앞에 두지 마라."], "src": "명상록 12권 4절"}, {"t0": 492.77599999999995, "t1": 499.8639999999999, "lines": ["좋은 사람을 논하지 말고,", "좋은 사람이 되어라."], "src": "명상록 10권 16절"}, {"t0": 572.136, "t1": 578.528, "lines": ["공동체를 위해 일했다면,", "나는 이미 보상받았다."], "src": "명상록 11권 4절"}]