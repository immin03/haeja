[{"t0": 118.636, "t1": 125.724, "lines": ["포도나무가 포도를 맺듯,", "선을 행하고 아무것도 바라지 마라."], "src": "명상록 5권 6절"}, {"t0": 207.484, "t1": 215.38799999999998, "lines": ["선을 행했으면 그것으로 끝이다,", "세 번째 것을 바라지 마라."], "src": "명상록 7권 73절"}, {"t0": 289.31600000000003, "t1": 295.108, "lines": ["이름은 금방 잊힌다,", "지금, 옳은 일을 하라."], "src": "명상록 4권 19절"}, {"t0": 369.52000000000004, "t1": 375.72, "lines": ["칭찬을 듣든 비난을 듣든,", "해야 할 일을 하라."], "src": "명상록 6권 2절"}, {"t0": 454.46000000000004, "t1": 460.372, "lines": ["남의 평가를,", "내 판단보다 앞에 두지 마라."], "src": "명상록 12권 4절"}, {"t0": 519.2040000000001, "t1": 526.292, "lines": ["좋은 사람을 논하지 말고,", "좋은 사람이 되어라."], "src": "명상록 10권 16절"}, {"t0": 603.8400000000001, "t1": 610.2320000000002, "lines": ["공동체를 위해 일했다면,", "나는 이미 보상받았다."], "src": "명상록 11권 4절"}]