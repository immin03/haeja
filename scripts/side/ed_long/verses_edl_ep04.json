[{"t0": 115.76400000000002, "t1": 121.38800000000002, "lines": ["처음 보이는 것 이상을,", "스스로에게 말하지 마라."], "src": "명상록 8권 49절"}, {"t0": 191.20400000000004, "t1": 197.88400000000004, "lines": ["그토록 다정하고 꾸밈없는 아내를,", "만난 것에 감사한다."], "src": "명상록 1권 17절"}, {"t0": 259.196, "t1": 264.748, "lines": ["잃는다는 것은,", "변한다는 것일 뿐이다."], "src": "명상록 9권 35절"}, {"t0": 326.74799999999993, "t1": 331.5559999999999, "lines": ["나는, 사람의 일을 하러", "일어난다."], "src": "명상록 5권 1절"}, {"t0": 393.77999999999986, "t1": 400.05199999999985, "lines": ["남을 위한 일에서 다음 일로,", "거기서 기쁨을 찾아라."], "src": "명상록 6권 7절"}]