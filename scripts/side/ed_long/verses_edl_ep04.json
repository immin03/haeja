[{"t0": 122.47600000000001, "t1": 128.10000000000002, "lines": ["처음 보이는 것 이상을,", "스스로에게 말하지 마라."], "src": "명상록 8권 49절"}, {"t0": 205.80400000000003, "t1": 212.48400000000004, "lines": ["그토록 다정하고 꾸밈없는 아내를,", "만난 것에 감사한다."], "src": "명상록 1권 17절"}, {"t0": 280.772, "t1": 286.324, "lines": ["잃는다는 것은,", "변한다는 것일 뿐이다."], "src": "명상록 9권 35절"}, {"t0": 357.19599999999997, "t1": 362.00399999999996, "lines": ["나는, 사람의 일을 하러", "일어난다."], "src": "명상록 5권 1절"}, {"t0": 431.4199999999999, "t1": 437.6919999999999, "lines": ["남을 위한 일에서 다음 일로,", "거기서 기쁨을 찾아라."], "src": "명상록 6권 7절"}]