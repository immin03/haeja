[[2.9699999999999998, 7.472, "“황제는 죽었다. 이제 로마는 나를 따르라.”", "nar", null], [10.642, 14.256, "배신한 사람에게 하는 가장 완벽한 복수.", "emph", null], [14.676, 18.194, "2천 년 전, 이 복수를 실제로 한 사람이 있습니다.", "nar", null], [18.214000000000002, 22.38, "여기, 그를 배신한 사람들의 이름이 든 상자가 있습니다.", "nar", null], [22.650000000000002, 24.872, "열어 보기만 하면 됩니다.", "nar", null], [27.750000000000004, 31.46, "그런데 그는, 상자를 불 속에 넣었습니다.", "nar", null], [46.33, 50.855999999999995, "십 년 전, 로마 동쪽 전선에 한 장군의 이름이 퍼졌습니다.", "nar", null], [51.146, 55.768, "파르티아와의 전쟁에서, 그는 적의 수도까지 밀고 들어갔습니다.", "nar", null], [55.988, 58.257999999999996, "이름은 아비디우스 카시우스.", "nar", null], [58.728, 60.998, "이 이름을 기억해 주십시오.", "nar", null], [61.288000000000004, 65.86200000000001, "시리아 출신의 그는, 규율이 무섭기로 이름난 장군이었습니다.", "nar", null], [65.90200000000002, 70.76400000000002, "황제는 그를 믿었습니다. 제국의 동쪽 전부를 맡겼습니다.", "nar", null], [70.98400000000001, 75.19800000000001, "군대도, 속주도, 전쟁을 치를 권한까지.", "nar", null], [75.48800000000001, 81.35800000000002, "서기 175년 봄. 황제는 멀리 도나우 강 전선에 있었습니다.", "nar", null], [81.39800000000001, 86.35600000000001, "쉰네 살의 황제는, 몇 해째 천막에서 겨울을 나고 있었습니다.", "nar", null], [86.57600000000001, 89.686, "그리고 그해, 황제가 쓰러집니다.", "nar", null], [89.97600000000001, 94.64600000000002, "병은 깊었고, 소문은 황제보다 빨리 움직였습니다.", "nar", null], [94.86600000000001, 98.24000000000002, "후계자인 아들 코모두스는 아직 열세 살.", "nar", null], [98.71000000000001, 102.516, "곁을 지키던 황후 파우스티나는 두려웠습니다.", "nar", null], [102.986, 106.912, "남편이 죽으면, 어린 아들은 어떻게 될 것인가.", "nar", null], [107.20200000000001, 112.01600000000002, "전해지기로는, 황후가 카시우스에게 몰래 편지를 보냈다고 합니다.", "nar", null], [112.236, 115.754, "황제가 죽으면, 당신이 제국을 맡아 달라고.", "nar", null], [116.224, 120.438, "이 편지를 기억해 주십시오. 진실은 아무도 모릅니다.", "nar", null], [120.908, 123.56200000000001, "몇 주 뒤, 시리아에 소식이 닿습니다.", "nar", null], [124.032, 126.638, "황제가 죽었다는 소식이었습니다.", "nar", null], [126.928, 132.534, "175년 4월, 카시우스는 군대 앞에서 황제를 선언합니다.", "nar", null], [132.55399999999997, 137.05599999999998, "“황제는 죽었다. 이제 로마는 나를 따르라.”", "nar", null], [137.27599999999998, 140.098, "시리아와 이집트가 그를 따랐습니다.", "nar", null], [140.38799999999998, 145.51399999999998, "곡창 이집트가 넘어가자, 원로원은 카시우스를 국가의 적으로 선포했습니다.", "nar", null], [145.73399999999998, 149.204, "그런데 며칠 뒤, 다른 소식이 도착합니다.", "nar", null], [149.67399999999998, 151.896, "황제는 살아 있었습니다.", "nar", null], [152.36599999999999, 156.82, "돌아갈 수 있었습니다. 실수였다고 말할 수도 있었습니다.", "nar", null], [157.29, 159.94400000000002, "그러나 그는 멈추지 않았습니다.", "nar", null], [160.414, 164.484, "도나우의 황제에게 소식이 닿은 것은 그 뒤였습니다.", "nar", null], [164.95399999999998, 169.024, "소식을 전한 것은 카파도키아 총독, 베루스였습니다.", "nar", null], [169.49399999999997, 173.612, "가장 믿은 사람의 이름이, 그 편지에 있었습니다.", "nar", null], [174.08199999999997, 177.69599999999997, "“그였단 말인가. 왜, 하필 그였는가.”", "mono", null], [178.16599999999997, 181.27599999999998, "황제는 처음에 이 소식을 숨겼습니다.", "nar", null], [185.24599999999998, 189.46, "제국의 절반이, 하룻밤 사이에 적이 될 수 있었습니다.", "nar", null], [189.92999999999998, 193.688, "그러나 소문은 막사 사이로 번졌습니다.", "nar", null], [194.158, 196.716, "병사들이 술렁이기 시작합니다.", "nar", null], [197.00599999999997, 202.06, "황제는 병사들을 모았습니다. 모두가 분노의 연설을 기다렸습니다.", "nar", null], [205.07999999999998, 209.102, "“병사들이여. 나는 분노하러 여기 선 것이 아니다.”", "mono", null], [209.57199999999997, 211.84199999999998, "“내 운명을 슬퍼하러 왔다.”", "mono", null], [212.13199999999998, 217.402, "“내게 가장 소중한 벗이, 나를 향해 음모를 꾸몄다.”", "mono", null], [217.62199999999999, 221.356, "“이 전쟁에서 내가 얻고 싶은 것은 하나다.”", "mono", null], [221.826, 224.912, "“내게 잘못한 사람을 용서하는 것.”", "mono", null], [225.382, 229.16400000000002, "“우정을 저버린 사람의 친구로 남는 것이다.”", "mono", null], [232.63400000000001, 236.44000000000003, "기록에 따르면, 황제는 그를 욕하지 않았습니다.", "nar", null], [236.91000000000003, 241.07600000000005, "그가 쓴 말은 하나, 은혜를 모르는 사람이었습니다.", "nar", null], [241.54600000000002, 244.29600000000005, "『명상록』에는 이런 문장이 있습니다.", "nar", null], [244.586, 250.26400000000004, "“은혜를 모르는 사람을 탓할 때는, 무엇보다 너 자신을 돌아보라.”", "mono", null], [250.484, 254.50600000000003, "믿음을 준 것은, 나의 선택이었다는 뜻입니다.", "nar", null], [254.976, 258.038, "황제는 서둘러 북쪽 전쟁을 끝냅니다.", "nar", null], [258.50800000000004, 262.266, "야만족들이 군사를 보내 돕겠다고 제안했습니다.", "nar", null], [262.73600000000005, 266.998, "“로마 사람끼리의 일을, 너희에게 보일 수는 없다.”", "mono", null], [267.4680000000001, 271.634, "그는 열세 살 아들을 곁으로 불러, 후계자로 세웠습니다.", "nar", null], [272.1040000000001, 275.43000000000006, "그리고 군대를 이끌고 동쪽으로 향합니다.", "nar", null], [279.4000000000001, 283.71000000000004, "살아 있는 카시우스를 만나, 용서하기 위해서였습니다.", "nar", null], [284.18000000000006, 287.002, "그러나 그 만남은 오지 않습니다.", "nar", null], [287.47200000000004, 289.238, "7월, 시리아.", "nar", null], [289.708, 294.114, "백인대장 안토니우스가, 말을 타고 카시우스에게 다가옵니다.", "nar", null], [294.584, 298.51, "칼이 목을 스쳤습니다. 치명상은 아니었습니다.", "nar", null], [298.98, 303.19399999999996, "말은 그대로 지나갔고, 십인대장이 끝을 맺었습니다.", "nar", null], [303.48400000000004, 305.346, "석 달 여엿새.", "nar", null], [308.66400000000004, 311.63, "그것이 그가 황제였던 시간입니다.", "nar", null], [312.50000000000006, 315.61, "그의 머리가 황제에게 오고 있었습니다.", "nar", null], [316.08000000000004, 318.51800000000003, "“묻어라. 보지 않겠다.”", "mono", null], [318.98800000000006, 322.242, "도착하기도 전에 묻으라는 명령이었습니다.", "nar", null], [322.71200000000005, 327.262, "“살아서 만나고 싶었다. 이제, 용서할 사람이 없다.”", "mono", null], [327.732, 330.002, "그는 이렇게 썼습니다.", "nar", null], [330.47200000000004, 335.022, "“가장 좋은 복수는, 그 사람과 같아지지 않는 것이다.”", "mono", null], [338.492, 342.394, "그리고 얼마 뒤, 상자 하나가 황제 앞에 도착합니다.", "nar", null], [342.86400000000003, 345.974, "“폐하. 카시우스의 편지들입니다.”", "nar", null], [346.264, 352.27799999999996, "“원로원 의원, 장군, 총독. 누가 그를 도왔는지, 전부 들어 있습니다.”", "nar", null], [352.498, 354.28799999999995, "“읽어 보았는가.”", "mono", null], [354.558, 358.02799999999996, "“아닙니다. 폐하께서 먼저 보셔야 합니다.”", "nar", null], [358.248, 362.46199999999993, "“이걸 읽으면, 내일 나는 누구를 보게 되겠나.”", "mono", null], [362.932, 365.65799999999996, "“폐하를 배신한 자들입니다.”", "nar", null], [365.94800000000004, 370.618, "“아니다. 내일부터는, 모든 사람이 배신자로 보일 것이다.”", "mono", null], [371.538, 373.28, "“불을 가져오게.”", "mono", null], [373.65000000000003, 377.624, "“폐하. 저들은 폐하를 죽이려 했습니다.”", "nar", null], [377.89400000000006, 381.148, "“그래서, 나까지 그들처럼 되어야 하겠나.”", "mono", null], [385.9680000000001, 389.43800000000005, "다른 기록은 베루스가 대신 태웠다고도 전합니다.", "nar", null], [389.80800000000005, 394.166, "확실한 것은, 그 이름들이 어디에도 남지 않았다는 것입니다.", "nar", null], [394.456, 399.726, "그 뒤 황제는 동쪽을 돌며, 반란에 가담한 도시들을 너그럽게 대했습니다.", "nar", null], [399.946, 403.368, "원로원은 공모자들을 처벌하라고 요구했습니다.", "nar", null], [403.658, 408.736, "“내 치세에, 원로원 의원이 피 흘리는 일은 없기를 바란다.”", "mono", null], [408.956, 411.37, "완전한 자비는 아니었습니다.", "nar", null], [411.84000000000003, 415.814, "카시우스의 아들은 살해됐고, 몇몇은 추방됐습니다.", "nar", null], [416.28400000000005, 418.05, "그리고 황후.", "nar", null], [418.22, 422.24199999999996, "그가 아내를 의심했는지, 기록은 말하지 않습니다.", "nar", null], [422.71200000000005, 426.782, "다만 그는, 신들에게 감사한 목록에 이렇게 적었습니다.", "nar", null], [427.25200000000007, 430.29, "“이런 아내가 내 곁에 있었던 것을.”", "mono", null], [435.26000000000005, 437.266, "2026년, 서울.", "nar", null], [437.73600000000005, 441.206, "오래 함께한 동업자, 가족, 친구.", "nar", null], [441.67600000000004, 445.242, "그 사람이 내 이야기를 어떻게 했는지 알 수 있는 메시지가", "nar", null], [445.71200000000005, 448.966, "오늘 손안에 있다면, 여러분은 열겠습니까.", "nar", null], [449.25600000000003, 454.574, "열면 이름을 얻습니다. 대신 그 이름을 평생 들고 삽니다.", "nar", null], [454.79400000000004, 458.504, "배신한 사람에게 하는 복수, 세 가지입니다.", "nar", null], [458.79400000000004, 463.848, "첫째, 욕하지 마십시오. 그 말은 내 입만 더럽힙니다.", "nar", null], [464.06800000000004, 467.538, "둘째, 그의 끝을 구경하지 마십시오.", "nar", null], [468.00800000000004, 471.862, "셋째, 알 필요 없는 것은 열지 마십시오.", "nar", null], [472.33200000000005, 475.442, "이것이, 황제가 한 복수였습니다.", "nar", null]]