[[2.9699999999999998, 7.472, "“황제는 죽었다. 이제 로마는 나를 따르라.”", "nar", null], [10.642, 14.256, "배신한 사람에게 하는 가장 완벽한 복수.", "emph", null], [14.676, 18.194, "2천 년 전, 이 복수를 실제로 한 사람이 있습니다.", "nar", null], [18.214000000000002, 22.38, "여기, 그를 배신한 사람들의 이름이 든 상자가 있습니다.", "nar", null], [22.650000000000002, 24.872, "열어 보기만 하면 됩니다.", "nar", null], [27.750000000000004, 31.46, "그런데 그는, 상자를 불 속에 넣었습니다.", "nar", null], [48.129999999999995, 52.65599999999999, "십 년 전, 로마 동쪽 전선에 한 장군의 이름이 퍼졌습니다.", "nar", null], [52.946, 57.568, "파르티아와의 전쟁에서, 그는 적의 수도까지 밀고 들어갔습니다.", "nar", null], [57.788, 60.05799999999999, "이름은 아비디우스 카시우스.", "nar", null], [60.328, 62.598, "이 이름을 기억해 주십시오.", "nar", null], [62.888, 67.462, "시리아 출신의 그는, 규율이 무섭기로 이름난 장군이었습니다.", "nar", null], [67.50200000000001, 72.36400000000002, "황제는 그를 믿었습니다. 제국의 동쪽 전부를 맡겼습니다.", "nar", null], [72.634, 76.848, "군대도, 속주도, 전쟁을 치를 권한까지.", "nar", null], [77.138, 83.00800000000001, "서기 175년 봄. 황제는 멀리 도나우 강 전선에 있었습니다.", "nar", null], [83.278, 88.236, "쉰네 살의 황제는, 몇 해째 천막에서 겨울을 나고 있었습니다.", "nar", null], [88.456, 91.566, "그리고 그해, 황제가 쓰러집니다.", "nar", null], [91.836, 96.506, "병은 깊었고, 소문은 황제보다 빨리 움직였습니다.", "nar", null], [96.726, 100.10000000000001, "후계자인 아들 코모두스는 아직 열세 살.", "nar", null], [100.57, 104.37599999999999, "곁을 지키던 황후 파우스티나는 두려웠습니다.", "nar", null], [104.646, 108.572, "남편이 죽으면, 어린 아들은 어떻게 될 것인가.", "nar", null], [108.862, 113.676, "전해지기로는, 황후가 카시우스에게 몰래 편지를 보냈다고 합니다.", "nar", null], [113.94599999999998, 117.46399999999998, "황제가 죽으면, 당신이 제국을 맡아 달라고.", "nar", null], [117.93399999999998, 122.14799999999998, "이 편지를 기억해 주십시오. 진실은 아무도 모릅니다.", "nar", null], [122.61799999999998, 125.27199999999999, "몇 주 뒤, 시리아에 소식이 닿습니다.", "nar", null], [125.54199999999999, 128.148, "황제가 죽었다는 소식이었습니다.", "nar", null], [128.43799999999996, 134.04399999999998, "175년 4월, 카시우스는 군대 앞에서 황제를 선언합니다.", "nar", null], [134.06399999999996, 138.56599999999997, "“황제는 죽었다. 이제 로마는 나를 따르라.”", "nar", null], [138.78599999999997, 141.608, "시리아와 이집트가 그를 따랐습니다.", "nar", null], [141.89799999999997, 147.02399999999997, "곡창 이집트가 넘어가자, 원로원은 카시우스를 국가의 적으로 선포했습니다.", "nar", null], [147.24399999999997, 150.714, "그런데 며칠 뒤, 다른 소식이 도착합니다.", "nar", null], [151.18399999999997, 153.40599999999998, "황제는 살아 있었습니다.", "nar", null], [153.67599999999996, 158.12999999999997, "돌아갈 수 있었습니다. 실수였다고 말할 수도 있었습니다.", "nar", null], [158.59999999999997, 161.254, "그러나 그는 멈추지 않았습니다.", "nar", null], [161.72399999999996, 165.79399999999998, "도나우의 황제에게 소식이 닿은 것은 그 뒤였습니다.", "nar", null], [166.26399999999995, 170.33399999999997, "소식을 전한 것은 카파도키아 총독, 베루스였습니다.", "nar", null], [170.80399999999995, 174.92199999999997, "가장 믿은 사람의 이름이, 그 편지에 있었습니다.", "nar", null], [175.19199999999992, 178.80599999999993, "“그였단 말인가. 왜, 하필 그였는가.”", "mono", null], [179.27599999999995, 182.38599999999997, "황제는 처음에 이 소식을 숨겼습니다.", "nar", null], [186.35599999999997, 190.57, "제국의 절반이, 하룻밤 사이에 적이 될 수 있었습니다.", "nar", null], [191.03999999999996, 194.79799999999997, "그러나 소문은 막사 사이로 번졌습니다.", "nar", null], [195.06799999999996, 197.62599999999998, "병사들이 술렁이기 시작합니다.", "nar", null], [197.91599999999997, 202.97, "황제는 병사들을 모았습니다. 모두가 분노의 연설을 기다렸습니다.", "nar", null], [205.98999999999998, 210.012, "“병사들이여. 나는 분노하러 여기 선 것이 아니다.”", "mono", null], [210.48199999999997, 212.75199999999998, "“내 운명을 슬퍼하러 왔다.”", "mono", null], [213.04199999999997, 218.31199999999998, "“내게 가장 소중한 벗이, 나를 향해 음모를 꾸몄다.”", "mono", null], [218.53199999999998, 222.266, "“이 전쟁에서 내가 얻고 싶은 것은 하나다.”", "mono", null], [222.736, 225.822, "“내게 잘못한 사람을 용서하는 것.”", "mono", null], [226.292, 230.074, "“우정을 저버린 사람의 친구로 남는 것이다.”", "mono", null], [233.544, 237.35000000000002, "기록에 따르면, 황제는 그를 욕하지 않았습니다.", "nar", null], [237.82000000000002, 241.98600000000005, "그가 쓴 말은 하나, 은혜를 모르는 사람이었습니다.", "nar", null], [242.45600000000002, 245.20600000000005, "『명상록』에는 이런 문장이 있습니다.", "nar", null], [245.476, 251.15400000000002, "“은혜를 모르는 사람을 탓할 때는, 무엇보다 너 자신을 돌아보라.”", "mono", null], [251.37400000000002, 255.39600000000004, "믿음을 준 것은, 나의 선택이었다는 뜻입니다.", "nar", null], [255.866, 258.928, "황제는 서둘러 북쪽 전쟁을 끝냅니다.", "nar", null], [259.398, 263.156, "야만족들이 군사를 보내 돕겠다고 제안했습니다.", "nar", null], [263.62600000000003, 267.888, "“로마 사람끼리의 일을, 너희에게 보일 수는 없다.”", "mono", null], [268.35800000000006, 272.524, "그는 열세 살 아들을 곁으로 불러, 후계자로 세웠습니다.", "nar", null], [272.9940000000001, 276.32000000000005, "그리고 군대를 이끌고 동쪽으로 향합니다.", "nar", null], [280.2900000000001, 284.6, "살아 있는 카시우스를 만나, 용서하기 위해서였습니다.", "nar", null], [285.07000000000005, 287.892, "그러나 그 만남은 오지 않습니다.", "nar", null], [288.16200000000003, 289.928, "7월, 시리아.", "nar", null], [290.398, 294.804, "백인대장 안토니우스가, 말을 타고 카시우스에게 다가옵니다.", "nar", null], [295.274, 299.2, "칼이 목을 스쳤습니다. 치명상은 아니었습니다.", "nar", null], [299.67, 303.88399999999996, "말은 그대로 지나갔고, 십인대장이 끝을 맺었습니다.", "nar", null], [304.17400000000004, 306.036, "석 달 여엿새.", "nar", null], [306.30600000000004, 309.272, "그것이 그가 황제였던 시간입니다.", "nar", null], [310.14200000000005, 313.252, "그의 머리가 황제에게 오고 있었습니다.", "nar", null], [313.72200000000004, 316.16, "“묻어라. 보지 않겠다.”", "mono", null], [316.63000000000005, 319.884, "도착하기도 전에 묻으라는 명령이었습니다.", "nar", null], [320.35400000000004, 324.904, "“살아서 만나고 싶었다. 이제, 용서할 사람이 없다.”", "mono", null], [325.374, 327.644, "그는 이렇게 썼습니다.", "nar", null], [328.11400000000003, 332.664, "“가장 좋은 복수는, 그 사람과 같아지지 않는 것이다.”", "mono", null], [336.134, 340.036, "그리고 얼마 뒤, 상자 하나가 황제 앞에 도착합니다.", "nar", null], [340.50600000000003, 343.616, "“폐하. 카시우스의 편지들입니다.”", "nar", null], [343.906, 349.91999999999996, "“원로원 의원, 장군, 총독. 누가 그를 도왔는지, 전부 들어 있습니다.”", "nar", null], [350.14, 351.92999999999995, "“읽어 보았는가.”", "mono", null], [352.2, 355.66999999999996, "“아닙니다. 폐하께서 먼저 보셔야 합니다.”", "nar", null], [355.69, 359.90399999999994, "“이걸 읽으면, 내일 나는 누구를 보게 되겠나.”", "mono", null], [360.12399999999997, 362.8499999999999, "“폐하를 배신한 자들입니다.”", "nar", null], [363.14, 367.80999999999995, "“아니다. 내일부터는, 모든 사람이 배신자로 보일 것이다.”", "mono", null], [368.72999999999996, 370.4719999999999, "“불을 가져오게.”", "mono", null], [370.842, 374.816, "“폐하. 저들은 폐하를 죽이려 했습니다.”", "nar", null], [375.086, 378.34, "“그래서, 나까지 그들처럼 되어야 하겠나.”", "mono", null], [383.16, 386.63, "다른 기록은 베루스가 대신 태웠다고도 전합니다.", "nar", null], [387.0, 391.35799999999995, "확실한 것은, 그 이름들이 어디에도 남지 않았다는 것입니다.", "nar", null], [391.64799999999997, 396.91799999999995, "그 뒤 황제는 동쪽을 돌며, 반란에 가담한 도시들을 너그럽게 대했습니다.", "nar", null], [397.138, 400.55999999999995, "원로원은 공모자들을 처벌하라고 요구했습니다.", "nar", null], [400.84999999999997, 405.92799999999994, "“내 치세에, 원로원 의원이 피 흘리는 일은 없기를 바란다.”", "mono", null], [406.14799999999997, 408.56199999999995, "완전한 자비는 아니었습니다.", "nar", null], [409.032, 413.006, "카시우스의 아들은 살해됐고, 몇몇은 추방됐습니다.", "nar", null], [413.476, 415.24199999999996, "그리고 황후.", "nar", null], [415.412, 419.4339999999999, "그가 아내를 의심했는지, 기록은 말하지 않습니다.", "nar", null], [419.904, 423.97399999999993, "다만 그는, 신들에게 감사한 목록에 이렇게 적었습니다.", "nar", null], [424.444, 428.65799999999996, "“이런 아내가 내 곁에 있었던 것에, 감사한다.”", "mono", null], [433.62800000000004, 435.634, "2026년, 서울.", "nar", null], [436.10400000000004, 439.574, "오래 함께한 동업자, 가족, 친구.", "nar", null], [440.04400000000004, 443.61, "그 사람이 내 이야기를 어떻게 했는지 알 수 있는 메시지가", "nar", null], [444.08000000000004, 447.334, "오늘 손안에 있다면, 여러분은 열겠습니까.", "nar", null], [447.624, 452.942, "열면 이름을 얻습니다. 대신 그 이름을 평생 들고 삽니다.", "nar", null], [453.16200000000003, 456.872, "배신한 사람에게 하는 복수, 세 가지입니다.", "nar", null], [457.16200000000003, 462.216, "첫째, 욕하지 마십시오. 그 말은 내 입만 더럽힙니다.", "nar", null], [462.43600000000004, 465.906, "둘째, 그의 끝을 구경하지 마십시오.", "nar", null], [466.37600000000003, 470.23, "셋째, 알 필요 없는 것은 열지 마십시오.", "nar", null], [470.70000000000005, 473.81, "이것이, 황제가 한 복수였습니다.", "nar", null]]