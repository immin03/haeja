 "subs": {
  "l000": "!배신한 사람에게 하는 가장 완벽한 복수.",
  "l001": "2천 년 전, 이 복수를 실제로 한 사람이 있습니다.",
  "l002": "여기, 그를 배신한 사람들의 이름이 든 상자가 있습니다.",
  "l003": "열어 보기만 하면 됩니다.",
  "l004": "그런데 그는, 상자를 불 속에 넣었습니다.",
  "l007": "십 년 전, 로마 동쪽 전선에 한 장군의 이름이 퍼졌습니다.",
  "l008": "파르티아와의 전쟁에서, 그는 적의 수도까지 밀고 들어갔습니다.",
  "l009": "이름은 아비디우스 카시우스.",
  "l010": "이 이름을 기억해 주십시오.",
  "n1": "시리아 출신의 그는, 규율이 무섭기로 이름난 장군이었습니다.",
  "l011": "황제는 그를 믿었습니다. 제국의 동쪽 전부를 맡겼습니다.",
  "l012": "군대도, 속주도, 전쟁을 치를 권한까지.",
  "l013": "서기 175년 봄. 황제는 멀리 도나우 강 전선에 있었습니다.",
  "l014": "쉰네 살의 황제는, 몇 해째 천막에서 겨울을 나고 있었습니다.",
  "l015": "그리고 그해, 황제가 쓰러집니다.",
  "l016": "병은 깊었고, 소문은 황제보다 빨리 움직였습니다.",
  "l017": "후계자인 아들 코모두스는 아직 열세 살.",
  "l018": "곁을 지키던 황후 파우스티나는 두려웠습니다.",
  "l019": "남편이 죽으면, 어린 아들은 어떻게 될 것인가.",
  "l020": "전해지기로는, 황후가 카시우스에게 몰래 편지를 보냈다고 합니다.",
  "l021": "황제가 죽으면, 당신이 제국을 맡아 달라고.",
  "l022": "이 편지를 기억해 주십시오. 진실은 아무도 모릅니다.",
  "l023": "몇 주 뒤, 시리아에 소식이 닿습니다.",
  "l024": "황제가 죽었다는 소식이었습니다.",
  "l025": "175년 4월, 카시우스는 군대 앞에서 황제를 선언합니다.",
  "l026": "“황제는 죽었다. 이제 로마는 나를 따르라.”",
  "l027": "시리아와 이집트가 그를 따랐습니다.",
  "n2": "곡창 이집트가 넘어가자, 원로원은 카시우스를 국가의 적으로 선포했습니다.",
  "l028": "그런데 며칠 뒤, 다른 소식이 도착합니다.",
  "l029": "황제는 살아 있었습니다.",
  "l030": "돌아갈 수 있었습니다. 실수였다고 말할 수도 있었습니다.",
  "l031": "그러나 그는 멈추지 않았습니다.",
  "l032": "도나우의 황제에게 소식이 닿은 것은 그 뒤였습니다.",
  "l033": "소식을 전한 것은 카파도키아 총독, 베루스였습니다.",
  "l034": "가장 믿은 사람의 이름이, 그 편지에 있었습니다.",
  "l035": "“그였단 말인가. 왜, 하필 그였는가.”",
  "l036": "황제는 처음에 이 소식을 숨겼습니다.",
  "n3": "제국의 절반이, 하룻밤 사이에 적이 될 수 있었습니다.",
  "l037": "그러나 소문은 막사 사이로 번졌습니다.",
  "l038": "병사들이 술렁이기 시작합니다.",
  "l039": "황제는 병사들을 모았습니다. 모두가 분노의 연설을 기다렸습니다.",
  "l040": "“병사들이여. 나는 분노하러 여기 선 것이 아니다.”",
  "l041": "“내 운명을 슬퍼하러 왔다.”",
  "l042": "“내게 가장 소중한 벗이, 나를 향해 음모를 꾸몄다.”",
  "l043": "“이 전쟁에서 내가 얻고 싶은 것은 하나다.”",
  "l044": "“내게 잘못한 사람을 용서하는 것.”",
  "l045": "“우정을 저버린 사람의 친구로 남는 것이다.”",
  "l047": "기록에 따르면, 황제는 그를 욕하지 않았습니다.",
  "l048": "그가 쓴 말은 하나, 은혜를 모르는 사람이었습니다.",
  "l049": "『명상록』에는 이런 문장이 있습니다.",
  "l050": "“은혜를 모르는 사람을 탓할 때는, 무엇보다 너 자신을 돌아보라.”",
  "l051": "믿음을 준 것은, 나의 선택이었다는 뜻입니다.",
  "l052": "황제는 서둘러 북쪽 전쟁을 끝냅니다.",
  "l053": "야만족들이 군사를 보내 돕겠다고 제안했습니다.",
  "l054": "“로마 사람끼리의 일을, 너희에게 보일 수는 없다.”",
  "n4": "그는 열세 살 아들을 곁으로 불러, 후계자로 세웠습니다.",
  "l055": "그리고 군대를 이끌고 동쪽으로 향합니다.",
  "l056": "살아 있는 카시우스를 만나, 용서하기 위해서였습니다.",
  "l057": "그러나 그 만남은 오지 않습니다.",
  "l058": "7월, 시리아.",
  "l059": "백인대장 안토니우스가, 말을 타고 카시우스에게 다가옵니다.",
  "l060": "칼이 목을 스쳤습니다. 치명상은 아니었습니다.",
  "l061": "말은 그대로 지나갔고, 십인대장이 끝을 맺었습니다.",
  "l062": "석 달 여엿새.",
  "l063": "그것이 그가 황제였던 시간입니다.",
  "l064": "그의 머리가 황제에게 오고 있었습니다.",
  "l065": "“묻어라. 보지 않겠다.”",
  "l066": "도착하기도 전에 묻으라는 명령이었습니다.",
  "l067": "“살아서 만나고 싶었다. 이제, 용서할 사람이 없다.”",
  "l068": "그는 이렇게 썼습니다.",
  "l069": "“가장 좋은 복수는, 그 사람과 같아지지 않는 것이다.”",
  "l070": "그리고 얼마 뒤, 상자 하나가 황제 앞에 도착합니다.",
  "l071": "“폐하. 카시우스의 편지들입니다.”",
  "l072": "“원로원 의원, 장군, 총독. 누가 그를 도왔는지, 전부 들어 있습니다.”",
  "l073": "“읽어 보았는가.”",
  "l074": "“아닙니다. 폐하께서 먼저 보셔야 합니다.”",
  "l075": "“이걸 읽으면, 내일 나는 누구를 보게 되겠나.”",
  "l076": "“폐하를 배신한 자들입니다.”",
  "l077": "“아니다. 내일부터는, 모든 사람이 배신자로 보일 것이다.”",
  "l078": "“불을 가져오게.”",
  "l079": "“폐하. 저들은 폐하를 죽이려 했습니다.”",
  "l080": "“그래서, 나까지 그들처럼 되어야 하겠나.”",
  "l082": "다른 기록은 베루스가 대신 태웠다고도 전합니다.",
  "l083": "확실한 것은, 그 이름들이 어디에도 남지 않았다는 것입니다.",
  "n5": "그 뒤 황제는 동쪽을 돌며, 반란에 가담한 도시들을 너그럽게 대했습니다.",
  "l084": "원로원은 공모자들을 처벌하라고 요구했습니다.",
  "l085": "“내 치세에, 원로원 의원이 피 흘리는 일은 없기를 바란다.”",
  "l086": "완전한 자비는 아니었습니다.",
  "l087": "카시우스의 아들은 살해됐고, 몇몇은 추방됐습니다.",
  "l088": "그리고 황후.",
  "l089": "그가 아내를 의심했는지, 기록은 말하지 않습니다.",
  "l090": "다만 그는, 신들에게 감사한 목록에 이렇게 적었습니다.",
  "l091": "“이런 아내가 내 곁에 있었던 것을.”",
  "l093": "2026년, 서울.",
  "l094": "오래 함께한 동업자, 가족, 친구.",
  "l095": "그 사람이 내 이야기를 어떻게 했는지 알 수 있는 메시지가",
  "l096": "오늘 손안에 있다면, 여러분은 열겠습니까.",
  "l097": "열면 이름을 얻습니다. 대신 그 이름을 평생 들고 삽니다.",
  "l098": "배신한 사람에게 하는 복수, 세 가지입니다.",
  "l099": "첫째, 욕하지 마십시오. 그 말은 내 입만 더럽힙니다.",
  "l100": "둘째, 그의 끝을 구경하지 마십시오.",
  "l101": "셋째, 알 필요 없는 것은 열지 마십시오.",
  "l102": "이것이, 황제가 한 복수였습니다."
 },
