[[1.3921670000000002, 3.259, "기원후 백칠십오 년 겨울.", "nar", null], [3.2416, 7.038, "타우루스 산맥 아래, 카파도키아의 작은 마을 할랄라.", "nar", null], [7.6080000000000005, 11.462000000000002, "“폐하… 황후께서, 숨을 거두셨습니다.”", "nar", null], [12.472125000000002, 15.230900000000002, "삼십 년을 함께한 아내, 파우스티나였습니다.", "nar", null], [15.60119, 20.09, "그날 밤, 제국에서 가장 강한 남자는, 막사에 혼자 남았습니다.", "nar", null], [20.760000000000005, 23.03, "그녀가 없는 아침이, 온다.", "mono", null], [23.800000000000004, 26.118000000000002, "그래도, 나는 일어나야 한다.", "emph", null]]