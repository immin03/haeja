 "subs": {
  "h_her": "“이것이, 루키우스를 대접한 대가입니까!”",
  "h1": "로마 황제 앞에서, 한 노인이 소리쳤습니다.",
  "h2": [
   "근위대장의 손이, 칼자루로 갔습니다.",
   "법정의 모두가, 피를 볼 거라고 생각했습니다."
  ],
  "m_h1": "오늘 나는, 무례한 사람을 만날 것이다.",
  "m_h2": "!나는 그것을, 이미 알고 있었다.",
  "s1": [
   "카시우스의 반란이 일어나기 한 해 전.",
   "황제는 다뉴브 전선의 도시, 시르미움에 머물고 있었습니다."
  ],
  "s2": [
   "그곳으로, 먼 아테네에서 시민 대표들이 찾아왔습니다.",
   "한 노인을 고발하기 위해서였습니다."
  ],
  "s3": [
   "헤로데스 아티쿠스.",
   "당대 최고의 웅변가이자, 젊은 황제에게 그리스어 웅변을 가르친 옛 스승이었습니다."
  ],
  "s_ath": "“황제시여, 아테네는 더 이상, 그 사람의 집 마당이 아닙니다.”",
  "s4": "황제는 전쟁터 한가운데서, 자기 스승의 재판을 열어야 했습니다.",
  "s5": "그 재판을 앞둔 날들에도, 황제의 아침은 언제나 같은 방식으로 시작되었습니다.",
  "d1a": "황제는 날이 밝으면, 하루를 시작하기 전에 자기 자신에게 먼저 말을 걸었습니다.",
  "d1b": "오늘 누구를 만나게 될지, 그 사람이 어떻게 나올지를, 미리 떠올려 보는 것이었습니다.",
  "m1a": "오늘 나는, 참견하는 자와, 은혜를 모르는 자와, 오만한 자를 만날 것이다.",
  "m1b": "그들은 무엇이 선이고 무엇이 악인지 모르기에, 그렇게 행동하는 것이다.",
  "m1c": [
   "아침마다 스스로에게 말하라.",
   "오늘 나는, 무례한 사람들을 만나게 될 것이라고."
  ],
  "d1c": [
   "스토아 철학자들은 이것을, 나쁜 일을 미리 그려 보는 연습이라고 불렀습니다.",
   "라틴어로, 프라에메디타티오 말로룸입니다."
  ],
  "d1d": [
   "법정에서 황제의 얼굴이 흔들리지 않았던 이유가, 여기에 있습니다.",
   "무례는 그에게, 아침마다 미리 만나 본 손님이었습니다."
  ],
  "d1e": [
   "월요일 아침, 회사 엘리베이터 앞.",
   "문이 열리기도 전에, 그 부장의 목소리가 벌써 들리는 것 같습니다."
  ],
  "d1f": "!미리 각오한 무례는, 나를 기습하지 못합니다.",
  "d1g": [
   "오늘 밤에는, 내일 만날 까다로운 사람 한 명과, 그가 할 법한 말을 미리 적어 보세요.",
   "내일 그 말은, 처음 듣는 말이 아닐 겁니다."
  ],
  "d1h": "그런데 재판 전날 밤, 아무도 예상하지 못한 일이 일어났습니다.",
  "d2a": [
   "그날 밤, 시르미움에 거센 폭풍이 몰아쳤습니다.",
   "번개 하나가, 헤로데스 일행이 묵던 숙소에 내리꽂혔습니다."
  ],
  "d2b": "그 자리에서, 헤로데스가 딸처럼 아끼며 키우던 쌍둥이 자매가 숨을 거두었습니다.",
  "d2c": "이미 자기 자식들을 여럿 먼저 떠나보낸 노인에게, 그 아이들은 남은 기쁨이었다고 전해집니다.",
  "d2d": "다음 날, 노인은 그 슬픔을 그대로 안은 채, 법정에 서게 됩니다.",
  "m2a": "누군가 나에게 잘못을 하면, 먼저 생각하라.",
  "m2b": "그는 무엇을 좋다고 여기고, 무엇을 나쁘다고 여겼기에, 그렇게 했는가.",
  "m2c": "그가 무엇을 옳다고 믿었는지 보면, 화 대신 연민이 남는다.",
  "d2e": [
   "황제는 사람을 볼 때, 행동보다 그 뒤에 있는 판단을 보려고 했습니다.",
   "무례한 말은 대개, 그 사람이 지고 있는 무게에서 나옵니다."
  ],
  "d2f": [
   "명절 식탁에서, 너는 아직도 그 회사 다니냐고 묻는 큰아버지.",
   "알고 보니 그는 평생, 자기 자식과 비교당하며 살아온 사람이었습니다."
  ],
  "d2g": [
   "!그를 이해한다고 그 말이 옳아지지는 않습니다.",
   "!다만, 내 화가 조금 작아질 뿐입니다."
  ],
  "d2h": "오늘 밤에는, 오늘 나를 언짢게 한 사람에게 있었을 사정을, 한 줄로 써 보세요.",
  "d2i": "그리고 날이 밝자, 재판이 시작되었습니다.",
  "d3a": [
   "물시계의 물이 떨어지기 시작했습니다.",
   "변론에 주어진 시간이었습니다."
  ],
  "d3b": [
   "헤로데스는 고발에 답하지 않았습니다.",
   "대신 황제를 똑바로 쳐다보며, 서운함을 쏟아 냈습니다."
  ],
  "d3c": [
   "그리고 물시계의 물이 다 떨어지기도 전에, 자리를 박차고 일어섰습니다.",
   "근위대장이 그 앞을 막아섰습니다."
  ],
  "p3": "“죽고 싶은 모양이군.”",
  "h3": "“늙은이는, 두려운 것이 별로 없소.”",
  "d3d": [
   "노인은 그대로, 법정을 나가 버렸습니다.",
   "황제의 법정에서, 황제에게 등을 보인 것입니다."
  ],
  "m3a": "무례한 자 때문에 화가 날 때면, 스스로에게 물어라.",
  "m3b": [
   "세상에 무례한 사람이 하나도 없을 수 있는가.",
   "그럴 수는 없다."
  ],
  "m3c": [
   "불가능한 것을 바라지 마라.",
   "무례한 사람이 없는 세상은 없다."
  ],
  "d3e": [
   "황제는 무례한 사람을 만나는 일을, 겨울에 추위를 만나는 일처럼 여겼습니다.",
   "놀랄 일이 아니라, 세상의 한 부분이라는 겁니다."
  ],
  "d3f": [
   "회사를 옮겨도, 모임을 옮겨도, 꼭 한 명은 있는 그 사람.",
   "이사 간 아파트에도, 위층에는 또 그런 집이 있었습니다."
  ],
  "d3g": "!어디에나 있는 사람이라면, 만날 때마다 놀랄 필요는 없습니다.",
  "d3h": "오늘 밤에는, 그런 사람도 있는 법이라고, 소리 내어 한 번 말해 보세요.",
  "d3i": "법정의 모든 눈이, 황제에게로 향했습니다.",
  "d4a": [
   "무거운 정적이 흘렀습니다.",
   "모두가, 황제가 크게 노할 거라고 생각했습니다."
  ],
  "d4b": "그러나 황제는 얼굴빛 하나 바꾸지 않고, 아테네 사람들을 향해 말했습니다.",
  "m4x": "“변론을, 계속하시오.”",
  "s_ath2": "“그는 우리 도시를, 자기 집 곳간처럼 다루었습니다.”",
  "d4c": [
   "아테네 사람들은 그동안 겪은 일들을 하나씩 털어놓았습니다.",
   "그 호소를 듣던 황제는, 끝내 눈물을 보였다고 전해집니다."
  ],
  "m4a": "그의 말이, 나를 해쳤는가.",
  "m4b": [
   "아니다.",
   "해쳤다고 여기는 내 판단이, 나를 해친다."
  ],
  "m4c": [
   "상처받았다는 생각을 버려라.",
   "그러면, 상처도 사라진다."
  ],
  "d4d": [
   "황제는 모욕을 마음에 담아 두지 않았습니다.",
   "그래서 그 자리에서, 모욕한 사람이 아니라 호소하는 사람들의 말을 들을 수 있었습니다."
  ],
  "d4e": [
   "식당 직원이 던진 퉁명스러운 한마디.",
   "집에 와서 씻고 누워서도, 그 말이 몇 번이고 다시 재생됩니다."
  ],
  "d4f": "!그 말은 한 번 들었는데, 상처는 내가 백 번 냈습니다.",
  "d4g": "오늘 밤에는, 오늘 들은 말 하나를, 실제로 들은 말과 내가 붙인 해석으로 나눠 적어 보세요.",
  "d4h": "재판이 끝난 그날 밤, 황제의 막사로 한 사람이 찾아왔습니다.",
  "d5a": [
   "근위대장이었습니다.",
   "그는 칼자루에 손을 얹은 채 말했습니다."
  ],
  "p5": "“폐하, 그는 모두가 보는 앞에서 폐하를 모욕했습니다. 본보기를 보이셔야 합니다.”",
  "d5b": [
   "궁정의 많은 사람이 같은 생각이었습니다.",
   "황제의 위엄이, 땅에 떨어졌다고."
  ],
  "m5a": "그들은 내 위엄이 무너졌다고 말한다.",
  "m5b": "그러나 한 노인의 무례가, 내 위엄을 가져갈 수는 없다.",
  "m5c": [
   "누가 나를 경멸하는가.",
   "그것은 그의 몫이다.",
   "내 몫은, 경멸받을 일을 하지 않는 것이다."
  ],
  "d5c": [
   "황제는 남의 평가와 자기 행동 사이에, 분명한 선을 그었습니다.",
   "남이 나를 어떻게 보는지는 그의 영역이고, 내가 어떻게 행동하는지만 내 영역이라는 겁니다."
  ],
  "d5d": "내가 없는 자리에서 누가 내 험담을 했다는 말을, 가장 친한 친구에게서 전해 들었을 때.",
  "d5e": [
   "!그가 나를 어떻게 말하는지는 그의 일입니다.",
   "!내가 어떻게 사는지만, 내 일입니다."
  ],
  "d5f": "오늘 밤에는, 누가 뭐라 하든 내가 부끄럽지 않게 한 일 하나를, 적어 보세요.",
  "d5g": "며칠 뒤, 판결이 내려졌습니다.",
  "d6a": [
   "모두가 무거운 벌을 예상했습니다.",
   "황제를 모욕한 죄였으니까요."
  ],
  "d6b": [
   "그러나 판결은 뜻밖에 가벼웠습니다.",
   "헤로데스 본인은 벌하지 않고, 그의 해방노예 몇 사람에게만 가벼운 벌을 내렸습니다."
  ],
  "d6c": "딸 같은 아이들을 잃은 노인에게는, 그 슬픔이 이미 충분한 벌이라고 여겼다고 전해집니다.",
  "m6a": [
   "그는 나를 모욕했다.",
   "나도 그를 모욕할 수 있다."
  ],
  "m6b": "그러나 그렇게 하는 순간, 나는 그와 같은 사람이 된다.",
  "m6c": "가장 좋은 복수는, 그와 같아지지 않는 것이다.",
  "d6d": [
   "황제는 일기에 이런 비유도 남겼습니다.",
   "레슬링 훈련장에서 상대가 손톱으로 할퀴어도, 우리는 그를 원수로 여기지 않고, 그저 조심할 뿐이라고."
  ],
  "d6e": "밤 열한 시, 무례한 문자에 더 날 선 답장을 썼다가, 전송 버튼 앞에서 멈춘 손가락.",
  "d6f": "!똑같이 갚는 순간, 그 사람이 나를 이깁니다.",
  "d6g": "오늘 밤에는, 보내려던 날 선 답장을, 하루만 묵혀 보세요.",
  "d6h": "그리고 시간이 흐른 뒤, 황제는 한 통의 편지를 썼습니다.",
  "d7a": "받는 사람은, 헤로데스 아티쿠스였습니다.",
  "d7b": "황제는 그에게, 지금도 변함없이 당신을 존경한다고 썼다고 전해집니다.",
  "d7c": "법정에서 등을 돌린 스승에게, 황제는 끝내 등을 돌리지 않았습니다.",
  "m7a": "사람은, 서로를 위해 태어났다.",
  "m7b": "무례한 사람도, 그 사람들 가운데 하나다.",
  "m7c": [
   "그러니 가르쳐라.",
   "가르칠 수 없다면, 견뎌라."
  ],
  "d7d": [
   "스토아 철학자들은 사람을, 한 몸의 손과 발처럼 서로 이어진 존재로 보았습니다.",
   "손이 발에게 화를 내며, 등을 돌릴 수는 없다는 겁니다."
  ],
  "d7e": [
   "삼십 년째 같은 말로 상처를 주는 부모님.",
   "그래도, 안 볼 수는 없는 사람."
  ],
  "d7f": [
   "!끊을 수 없는 사람이라면, 가르치거나 견디면 됩니다.",
   "!다만, 닮지는 마세요."
  ],
  "d7g": "오늘 밤에는, 가르칠 사람과 견딜 사람을, 한 명씩 나눠 보세요.",
  "r1": "무례한 사람 앞에서, 황제가 일기에 남긴 일곱 문장을 다시 짚어 보겠습니다.",
  "r2": "첫째, 아침마다 미리 각오하라.",
  "r3": "둘째, 그가 무엇을 옳다고 믿었는지 보라.",
  "r4": "셋째, 무례한 사람이 없는 세상은 없다.",
  "r5": "넷째, 상처받았다는 생각을 내려놓아라.",
  "r6": "다섯째, 경멸은 그의 몫이다.",
  "r7": "여섯째, 가장 좋은 복수는, 닮지 않는 것.",
  "r8": "일곱째, 가르치거나, 견디거나.",
  "r9": [
   "!무례는 막을 수 없습니다.",
   "!내가 그와 같아지지 않는 것만이, 내 몫입니다."
  ],
  "o1": "오늘 이야기가 마음에 닿으셨다면, 구독과 좋아요로 황제의 일기를 함께 이어 가 주세요.",
  "o2": "다음 이야기에서는, 아무도 알아주지 않을 때 황제가 붙잡았던 문장들을 들려드리겠습니다."
 },
