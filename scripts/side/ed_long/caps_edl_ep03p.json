[[1.02, 5.666, "“황후의 비단옷이오! 금실로 수놓은, 황후의 옷이오!”", "nar", null], [6.134875, 9.2355, "기원후 백육십구 년, 로마 트라야누스 광장.", "nar", null], [9.70485, 13.098, "황제가, 궁전의 보물을 시장에 내놓았습니다.", "nar", null], [13.679708, 16.9611, "황금 잔과 수정 그릇, 그리고 황후의 옷까지.", "nar", null], [17.212400000000002, 19.241999999999997, "사람들은 수군거렸습니다.", "nar", null], [19.612000000000002, 23.921999999999997, "“철학에 빠진 황제가, 이제는 장사꾼이 되었군.”", "nar", null], [24.692, 27.081999999999997, "아무도 알아주지 않을 것이다.", "mono", null], [27.352, 29.621999999999996, "그래도, 나는 한다.", "emph", null]]