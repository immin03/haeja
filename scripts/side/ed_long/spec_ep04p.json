 "subs": {
  "h1": [
   "기원후 백칠십오 년 겨울.",
   "타우루스 산맥 아래, 카파도키아의 작은 마을 할랄라."
  ],
  "h_maid": "“폐하… 황후께서, 숨을 거두셨습니다.”",
  "h2": [
   "삼십 년을 함께한 아내, 파우스티나였습니다.",
   "그날 밤, 제국에서 가장 강한 남자는, 막사에 혼자 남았습니다."
  ],
  "m_h1": "그녀가 없는 아침이, 온다.",
  "m_h2": "!그래도, 나는 일어나야 한다.",
  "s1": [
   "몇 달 전, 제국에 거짓 소문이 퍼졌습니다.",
   "황제가 죽었다는 소문이었습니다."
  ],
  "s2": [
   "동방을 맡고 있던 장군 아비디우스 카시우스는, 그 소문을 믿고 스스로 황제라 선언했습니다.",
   "첫 번째 이야기에서 들려드린, 바로 그 반란입니다."
  ],
  "s3": [
   "반란은 석 달 만에 끝났습니다.",
   "황제는 흔들린 동방을 다독이러 먼 길을 떠났고, 황후 파우스티나가 그 길을 함께했습니다."
  ],
  "s4": "그리고 돌아오는 길, 산맥 아래 작은 마을에서, 황후는 병으로 쓰러졌습니다.",
  "d1q": [
   "한밤중에 걸려 온 전화 한 통.",
   "아버지가 쓰러지셨다는 말에, 머릿속에는 온갖 생각이 한꺼번에 몰려듭니다."
  ],
  "d1a": "그날 밤, 황제의 머릿속에도 생각이 몰려들었을 겁니다.",
  "d1b": [
   "내가 그 먼 길에 데려오지 않았다면.",
   "조금만 더 일찍, 의사를 불렀다면."
  ],
  "d1c": [
   "새벽이 오도록, 황제는 등불 옆에 앉아 있었습니다.",
   "그리고 일기를 펼쳤습니다."
  ],
  "m1a": [
   "내 아이가 아프다.",
   "그것은 보인다."
  ],
  "m1b": "그러나 아이가 위험하다는 것은, 보이지 않는다.",
  "m1c": "처음 보이는 것 이상을, 스스로에게 말하지 마라.",
  "d1d": [
   "황제는 일어난 사실과, 내가 그 위에 덧붙이는 이야기를 나누었습니다.",
   "아내가 떠났다는 것은 사실입니다.",
   "그러나 '모두 내 탓이다'는, 내가 덧붙인 이야기였습니다."
  ],
  "d1e": [
   "!일어난 일은 하나입니다.",
   "!그 위에 쌓는 이야기가, 사람을 무너뜨립니다."
  ],
  "d1t": "날이 밝자, 로마에서 온 편지 한 통이 막사에 닿았습니다.",
  "d2q": [
   "남편을 떠나보내고 한 달.",
   "사람들은 이제 어떻게 살 거냐고 묻습니다.",
   "그런데 떠오르는 건, 그가 남기고 간 빈자리뿐입니다."
  ],
  "d2a": [
   "편지에는, 차가운 소문이 적혀 있었습니다.",
   "황후가 카시우스와 몰래 편지를 주고받으며, 반란을 부추겼다는 소문이었습니다."
  ],
  "r_sen": "“황후가 반란을 부추겼다더군. 그러니 하늘이 데려간 거지.”",
  "d2b": [
   "황제는 그 소문에 답하지 않았습니다.",
   "대신 원로원에 편지를 보냈습니다.",
   "아내를, 신으로 모시게 해 달라고."
  ],
  "m2a": "나는 신들께 감사한다.",
  "m2b": "그토록 순하고, 그토록 다정하고, 그토록 꾸밈없는 사람이, 내 아내였음을.",
  "m2c": "그토록 다정하고 꾸밈없는 아내를 만난 것에, 감사한다.",
  "d2c": [
   "황제는 잃은 것을 세지 않고, 받은 것을 셌습니다.",
   "열다섯 살 신부와 스물네 살 신랑으로 만나 함께한 삼십 년.",
   "함께 키운 아이들.",
   "함께 건넌 전쟁터."
  ],
  "d2d": "!떠난 사람이 남긴 것을 세는 동안, 그 사람은 내 안에서 다시 살아납니다.",
  "d2t": "며칠 뒤, 마을 밖 언덕에 장작이 쌓였습니다.",
  "d3q": [
   "열다섯 해를 함께한 강아지를 떠나보낸 날.",
   "집 안의 모든 것이 그대로인데, 모든 것이 달라져 있습니다."
  ],
  "d3a": [
   "황후를 위한 장례의 불이, 겨울 하늘로 타올랐습니다.",
   "병사들은 깃발을 내리고, 말없이 서 있었습니다."
  ],
  "d3b": [
   "황제에게 이별은, 처음이 아니었습니다.",
   "그는 이미 여러 아이를 먼저 떠나보낸 아버지였습니다."
  ],
  "m3a": "어제의 것은 오늘 다른 것이 되고, 오늘의 것은 내일 또 다른 것이 된다.",
  "m3b": "자연은, 그 변화를 기뻐한다.",
  "m3c": "잃는다는 것은, 변한다는 것일 뿐이다.",
  "d3c": [
   "황제에게 죽음은, 사라짐이 아니라 자연의 큰 흐름으로 돌아가는 일이었습니다.",
   "슬퍼하지 말라는 말이 아닙니다.",
   "끝이라고만, 여기지 말라는 겁니다."
  ],
  "d3d": [
   "!함께한 시간은 사라지지 않습니다.",
   "!모양을 바꿔, 내 안에 남을 뿐입니다."
  ],
  "d3t": [
   "장례가 끝난 다음 날 새벽.",
   "황제는, 다시 일어나야 했습니다."
  ],
  "d4q": [
   "아내를 보낸 지 한 달.",
   "출근길 버스 창밖으로, 아무 일 없다는 듯 돌아가는 세상이 야속하기만 합니다."
  ],
  "d4a": [
   "막사 밖에는, 서기와 장교들이 기다리고 있었습니다.",
   "반란에 흔들린 동방의 도시들이, 황제의 판단을 기다리고 있었습니다."
  ],
  "d4b": [
   "황제는 다시 길을 나섰습니다.",
   "그리고 반란에 가담했던 도시들에, 대부분 벌 대신 용서를 내렸습니다."
  ],
  "m4a": "새벽에 일어나기 싫을 때, 이렇게 말하라.",
  "m4b": "나는 따뜻한 이불 속에 있으려고, 태어난 것이 아니다.",
  "m4c": "나는, 사람의 일을 하러 일어난다.",
  "d4c": [
   "슬픔을 이겨 내라는 말이 아닙니다.",
   "슬픔을 안은 채로, 오늘 해야 할 작은 일 하나로 돌아가라는 겁니다.",
   "황제에게 그 일은, 제국을 돌보는 일이었습니다."
  ],
  "d4d": [
   "!밥을 짓고, 집을 나서고, 화분에 물을 주는 일.",
   "!그 작은 일이, 나를 다시 일으킵니다."
  ],
  "d4t": "그리고 얼마 뒤, 황제는 아내를 위해, 한 가지 일을 시작했습니다.",
  "d5q": "어머니를 떠나보낸 뒤, 그 그리움을 어디에 두어야 할지, 아직도 모르겠습니다.",
  "d5a": "황제는 아내가 숨을 거둔 마을 할랄라를, 파우스티노폴리스, 파우스티나의 도시라고 이름 붙였습니다.",
  "d5b": [
   "그리고 아내의 이름으로, 가난한 집 소녀들을 돕는 기금을 세웠습니다.",
   "사람들은 그 아이들을, 파우스티나의 소녀들이라고 불렀습니다."
  ],
  "m5a": "한 가지에서 기쁨을 찾고, 거기서 쉬어라.",
  "m5b": "남을 위한 한 가지 일에서, 또 다른 일로 옮겨 가는 것.",
  "m5c": "남을 위한 일에서 다음 일로, 거기서 기쁨을 찾아라.",
  "d5c": [
   "황제는 그리움을, 가슴속에만 두지 않았습니다.",
   "아내의 이름으로, 누군가의 내일을 도왔습니다.",
   "그렇게 슬픔은, 세상에 남는 좋은 일이 되었습니다."
  ],
  "d5d": [
   "!어머니의 이름으로 건넨 작은 장학금 하나.",
   "!그리움은 그렇게, 누군가의 내일이 됩니다."
  ],
  "c1": [
   "그날 밤, 막사에 혼자 남았던 황제.",
   "그 뒤로도 그는 몇 해를 더 살며, 마지막까지 제국을 지켰습니다."
  ],
  "m_c1": [
   "그녀가 없는 아침이, 왔다.",
   "그리고 나는, 일어났다."
  ],
  "r1": "소중한 사람을 잃었을 때, 황제가 일기에 남긴 다섯 가지 방법을, 다시 짚어 보겠습니다.",
  "t0": "오늘 밤, 잠들기 전에, 이 세 가지만 해 보세요.",
  "r9": [
   "!떠난 사람은 돌아오지 않습니다.",
   "!그러나 그 사람에게 받은 것은, 오늘도 나를 살게 합니다."
  ],
  "o1": [
   "좋아요와 구독은, 영상 제작에 큰 힘이 됩니다.",
   "감사합니다."
  ],
  "o2": "다음 이야기에서도, 황제가 일기에 남긴 문장들을 들려드리겠습니다."
 },
