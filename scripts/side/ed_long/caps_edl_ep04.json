[[1.3921670000000002, 3.259, "기원후 백칠십오 년 겨울.", "nar", null], [3.2416, 7.038, "타우루스 산맥 아래, 카파도키아의 작은 마을 할랄라.", "nar", null], [7.6080000000000005, 11.462000000000002, "“폐하… 황후께서, 숨을 거두셨습니다.”", "nar", null], [12.472125000000002, 15.230900000000002, "삼십 년을 함께한 아내, 파우스티나였습니다.", "nar", null], [15.60119, 20.09, "그날 밤, 제국에서 가장 강한 남자는, 막사에 혼자 남았습니다.", "nar", null], [20.760000000000005, 23.03, "그녀가 없는 아침이, 온다.", "mono", null], [23.800000000000004, 26.118000000000002, "그래도, 나는 일어나야 한다.", "emph", null], [43.049167000000004, 45.84942, "몇 달 전, 제국에 거짓 소문이 퍼졌습니다.", "nar", null], [46.18883, 48.61, "황제가 죽었다는 소문이었습니다.", "nar", null], [49.738271000000005, 55.55473, "동방을 맡고 있던 장군 아비디우스 카시우스는, 그 소문을 믿고 스스로 황제라 선언했습니다.", "nar", null], [55.63235, 58.754, "첫 번째 이야기에서 들려드린, 바로 그 반란입니다.", "nar", null], [59.915667, 61.761599999999994, "반란은 석 달 만에 끝났습니다.", "nar", null], [61.99554, 67.89, "황제는 흔들린 동방을 다독이러 먼 길을 떠났고, 황후 파우스티나가 그 길을 함께했습니다.", "nar", null], [68.66000000000001, 74.72200000000001, "그리고 돌아오는 길, 산맥 아래 작은 마을에서, 황후는 병으로 쓰러졌습니다.", "nar", null], [80.69183300000002, 83.60967000000001, "한밤중, 요양병원에서 걸려 온 전화 한 통.", "nar", null], [83.67433000000001, 86.16600000000001, "아버지가, 방금 돌아가셨다고 합니다.", "nar", null], [86.975542, 89.98619000000001, "빈소에 앉아서도, 머릿속에는 같은 말만 맴돕니다.", "nar", null], [90.04804000000001, 92.26165000000002, "지난 주말에 찾아뵀더라면.", "nar", null], [92.33983, 94.30600000000001, "그날 전화를, 조금만 더 길게 받았더라면.", "nar", null], [95.17600000000002, 99.99000000000002, "그날 밤, 황제의 머릿속에도 생각이 몰려들었을 겁니다.", "nar", null], [100.76000000000002, 103.58717000000003, "내가 그 먼 길에 데려오지 않았다면.", "nar", null], [103.55440000000002, 106.41400000000003, "조금만 더 일찍, 의사를 불렀다면.", "nar", null], [107.28997900000002, 110.80071000000002, "새벽이 오도록, 황제는 등불 옆에 앉아 있었습니다.", "nar", null], [111.07081000000002, 113.38600000000002, "그리고 일기를 펼쳤습니다.", "nar", null], [114.35600000000002, 115.81940000000003, "내 아이가 아프다.", "mono", null], [115.94779000000003, 117.49000000000002, "그것은 보인다.", "mono", null], [118.26000000000002, 121.82600000000002, "그러나 아이가 위험하다는 것은, 보이지 않는다.", "mono", null], [128.770021, 133.89525000000003, "황제는 일어난 사실과, 내가 그 위에 덧붙이는 이야기를 나누었습니다.", "nar", null], [134.287, 136.81719000000004, "아내가 떠났다는 것은 사실입니다.", "nar", null], [136.97325, 141.08200000000002, "그러나 '모두 내 탓이다'는, 내가 덧붙인 이야기였습니다.", "nar", null], [142.311792, 143.76242000000002, "일어난 일은 하나입니다.", "emph", null], [143.88302, 146.674, "그 위에 쌓는 이야기가, 사람을 무너뜨립니다.", "emph", null], [148.44400000000002, 153.16200000000003, "날이 밝자, 로마에서 온 편지 한 통이 막사에 닿았습니다.", "nar", null], [158.42937500000002, 160.33098000000004, "남편을 떠나보내고 한 달.", "nar", null], [160.39246, 162.78731000000002, "사람들은 이제 어떻게 살 거냐고 묻습니다.", "nar", null], [162.90848, 166.44600000000003, "그런데 떠오르는 건, 그가 남기고 간 빈자리뿐입니다.", "nar", null], [167.27297900000002, 170.45812000000004, "위로한다며 건넨 말들이, 오히려 가슴을 찌릅니다.", "nar", null], [170.51050000000004, 174.03400000000005, "이제 그만 잊으라고, 산 사람은 살아야 한다고.", "nar", null], [175.14975, 177.62762000000004, "편지에는, 차가운 소문이 적혀 있었습니다.", "nar", null], [177.78875000000002, 182.62200000000004, "황후가 카시우스와 몰래 편지를 주고받으며, 반란을 부추겼다는 소문이었습니다.", "nar", null], [182.69200000000004, 186.45000000000005, "“황후가 반란을 부추겼다더군. 그러니 하늘이 데려간 거지.”", "nar", null], [187.27679200000003, 189.17854000000005, "황제는 그 소문에 답하지 않았습니다.", "nar", null], [189.35121000000004, 192.27619000000004, "대신 원로원에 편지를 보냈습니다.", "nar", null], [192.50892000000005, 194.43000000000006, "아내를, 신으로 모시게 해 달라고.", "nar", null], [195.50000000000003, 197.77000000000004, "나는 신들께 감사한다.", "mono", null], [198.54000000000002, 205.15400000000002, "그토록 순하고, 그토록 다정하고, 그토록 꾸밈없는 사람이, 내 아내였음을.", "mono", null], [213.06833300000002, 216.18973000000005, "황제는 잃은 것을 세지 않고, 받은 것을 셌습니다.", "nar", null], [216.31788000000003, 220.00802000000004, "열다섯 살 신부와 스물네 살 신랑으로 만나 함께한 삼십 년.", "nar", null], [219.97827000000004, 221.42846000000006, "함께 키운 아이들.", "nar", null], [221.38221000000004, 223.21000000000004, "함께 건넌 전쟁터.", "nar", null], [224.18, 228.99400000000003, "떠난 사람이 남긴 것을 세는 동안, 그 사람은 내 안에서 다시 살아납니다.", "emph", [224.41572900000003, 226.48467000000002]], [230.66400000000002, 234.27800000000002, "며칠 뒤, 마을 밖 언덕에 장작이 쌓였습니다.", "nar", null], [240.208729, 242.87183000000005, "열다섯 해를 함께한 강아지를 떠나보낸 날.", "nar", null], [243.14717000000002, 247.10600000000002, "집 안의 모든 것이 그대로인데, 모든 것이 달라져 있습니다.", "nar", null], [247.841583, 250.05225000000004, "누군가는 고작 개 한 마리라고 말합니다.", "nar", null], [250.12477, 253.78200000000004, "하지만 내게는, 열다섯 해의 아침과 저녁이었습니다.", "nar", null], [255.04295800000003, 258.07679, "황후를 위한 장례의 불이, 겨울 하늘로 타올랐습니다.", "nar", null], [258.20142000000004, 261.818, "병사들은 깃발을 내리고, 말없이 서 있었습니다.", "nar", null], [262.81375, 265.57928999999996, "황제에게 이별은, 처음이 아니었습니다.", "nar", null], [265.91892, 269.60999999999996, "그는 이미 여러 아이를 먼저 떠나보낸 아버지였습니다.", "nar", null], [270.78000000000003, 276.626, "어제의 것은 오늘 다른 것이 되고, 오늘의 것은 내일 또 다른 것이 된다.", "mono", null], [277.396, 280.12199999999996, "자연은, 그 변화를 기뻐한다.", "mono", null], [286.54400000000004, 292.2395, "황제에게 죽음은, 사라짐이 아니라 자연의 큰 흐름으로 돌아가는 일이었습니다.", "nar", null], [292.22669, 294.20915, "슬퍼하지 말라는 말이 아닙니다.", "nar", null], [294.56319, 296.854, "끝이라고만, 여기지 말라는 겁니다.", "nar", null], [298.03816700000004, 300.04465, "함께한 시간은 사라지지 않습니다.", "emph", null], [300.06421000000006, 302.442, "모양을 바꿔, 내 안에 남을 뿐입니다.", "emph", null], [304.43725, 306.32315, "장례가 끝난 다음 날 새벽.", "nar", null], [306.29475, 308.638, "황제는, 다시 일어나야 했습니다.", "nar", null], [314.511729, 315.91929, "아내를 보낸 지 한 달.", "nar", null], [315.95429, 320.818, "출근길 버스 창밖으로, 아무 일 없다는 듯 돌아가는 세상이 야속하기만 합니다.", "nar", null], [321.645479, 325.60765, "그래도 아침이면, 서툰 손으로 셔츠를 다려 입고 집을 나섭니다.", "nar", null], [325.90754, 329.39, "아내가 늘 해 주던 일을, 이제는 혼자 합니다.", "nar", null], [330.506646, 334.07697999999993, "막사 밖에는, 서기와 장교들이 기다리고 있었습니다.", "nar", null], [334.40855999999997, 338.7699999999999, "반란에 흔들린 동방의 도시들이, 황제의 판단을 기다리고 있었습니다.", "nar", null], [339.80897899999997, 342.0497699999999, "황제는 다시 길을 나섰습니다.", "nar", null], [342.30841999999996, 346.9459999999999, "그리고 반란에 가담했던 도시들에, 대부분 벌 대신 용서를 내렸습니다.", "nar", null], [348.116, 351.44199999999995, "새벽에 일어나기 싫을 때, 이렇게 말하라.", "mono", null], [352.212, 356.54599999999994, "나는 따뜻한 이불 속에 있으려고, 태어난 것이 아니다.", "mono", null], [362.50720799999993, 364.7620599999999, "슬픔을 이겨 내라는 말이 아닙니다.", "nar", null], [365.02201999999994, 369.05657999999994, "슬픔을 안은 채로, 오늘 해야 할 작은 일 하나로 돌아가라는 겁니다.", "nar", null], [369.17343999999997, 372.4419999999999, "황제에게 그 일은, 제국을 돌보는 일이었습니다.", "nar", null], [373.621604, 376.65934999999996, "밥을 짓고, 집을 나서고, 화분에 물을 주는 일.", "emph", null], [376.73528999999996, 379.37799999999993, "그 작은 일이, 나를 다시 일으킵니다.", "emph", null], [381.04799999999994, 385.6699999999999, "그리고 얼마 뒤, 황제는 아내를 위해, 한 가지 일을 시작했습니다.", "nar", null], [391.47158299999995, 393.3573299999999, "어머니를 떠나보낸 지 일 년.", "nar", null], [393.3772899999999, 397.2979999999999, "휴대폰에는 아직도, 엄마라는 이름을 지우지 못했습니다.", "nar", null], [397.7679999999999, 403.54199999999986, "보고 싶은 마음은 그대로인데, 그 그리움을 어디에 두어야 할지, 아직도 모르겠습니다.", "nar", null], [404.4119999999999, 411.57799999999986, "황제는 아내가 숨을 거둔 마을 할랄라를, 파우스티노폴리스, 파우스티나의 도시라고 이름 붙였습니다.", "nar", null], [412.7417709999999, 416.80868999999984, "그리고 아내의 이름으로, 가난한 집 소녀들을 돕는 기금을 세웠습니다.", "nar", null], [417.0424799999999, 420.90599999999984, "사람들은 그 아이들을, 파우스티나의 소녀들이라고 불렀습니다.", "nar", null], [422.0759999999999, 425.4499999999999, "한 가지에서 기쁨을 찾고, 거기서 쉬어라.", "mono", null], [426.2199999999999, 430.76999999999987, "남을 위한 한 가지 일에서, 또 다른 일로 옮겨 가는 것.", "mono", null], [438.3158749999999, 441.57630999999986, "황제는 그리움을, 가슴속에만 두지 않았습니다.", "nar", null], [441.89893999999987, 444.71166999999986, "아내의 이름으로, 누군가의 내일을 도왔습니다.", "nar", null], [444.7117299999999, 448.1779999999998, "그렇게 슬픔은, 세상에 남는 좋은 일이 되었습니다.", "nar", null], [449.5427709999999, 452.9674199999999, "어머니의 이름으로 건넨 작은 장학금 하나.", "emph", null], [453.0670399999999, 455.06599999999986, "그리움은 그렇게, 누군가의 내일이 됩니다.", "emph", null], [457.06977099999983, 459.6747440789472, "그날 밤, 막사에 혼자 남았던 황제.", "nar", null], [459.4447440789472, 464.2419999999998, "그 뒤로도 그는 몇 해를 더 살며, 마지막까지 제국을 지켰습니다.", "nar", null], [465.3797709999999, 467.54791999999986, "그녀가 없는 아침이, 왔다.", "mono", null], [467.5869999999999, 469.5939999999998, "그리고 나는, 일어났다.", "mono", null], [481.75199999999984, 485.5099999999998, "오늘 밤, 잠들기 전에, 이 세 가지만 해 보세요.", "nar", null], [492.2799999999998, 494.38428999999974, "떠난 사람은 돌아오지 않습니다.", "emph", null], [494.5779199999998, 498.38999999999976, "그러나 그 사람에게 받은 것은, 오늘도 나를 살게 합니다.", "emph", null]]