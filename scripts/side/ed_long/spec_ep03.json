 "subs": {
  "h_cr": "“황후의 비단옷이오! 금실로 수놓은, 황후의 옷이오!”",
  "h1": [
   "기원후 백육십구 년, 로마 트라야누스 광장.",
   "황제가, 궁전의 보물을 시장에 내놓았습니다."
  ],
  "h2": [
   "황금 잔과 수정 그릇, 그리고 황후의 옷까지.",
   "사람들은 수군거렸습니다."
  ],
  "h_sen": "“철학에 빠진 황제가, 이제는 장사꾼이 되었군.”",
  "m_h1": "아무도 알아주지 않을 것이다.",
  "m_h2": "!그래도, 나는 한다.",
  "s1": [
   "삼 년 전.",
   "동방 원정을 마친 군대가, 승리의 행렬을 이루며 로마로 돌아왔습니다."
  ],
  "s2": [
   "그런데 그 행렬과 함께, 보이지 않는 손님이 따라 들어왔습니다.",
   "역병이었습니다."
  ],
  "s3": [
   "훗날 안토니누스 역병이라 불린 이 병은, 제국 곳곳에서 수많은 목숨을 앗아 갔습니다.",
   "의사 갈레노스는, 열병과 붉은 발진을 기록으로 남겼습니다."
  ],
  "s4": "황제는 로마를 떠나지 않았습니다.",
  "d1a": [
   "시신은 수레에 실려 나갔습니다.",
   "가난한 사람들에게는, 장례를 치를 돈조차 없었습니다."
  ],
  "d1b": "황제는 나라의 돈으로, 가난한 이들의 장례를 치러 주게 했다고 전해집니다.",
  "w1": "“우리 남편 장례를, 황제께서 치러 주셨대요. 그런데 그분 얼굴은, 한 번도 못 봤어요.”",
  "d1c": "황제는 그 일을, 어디에도 드러내지 않았습니다.",
  "m1a": "어떤 사람은 남에게 잘해 주고, 그 빚을 꼭 받아 내려 한다.",
  "m1b": "어떤 사람은 입으로는 말하지 않아도, 마음속에 장부를 적는다.",
  "m1c": "포도나무가 포도를 맺듯, 선을 행하고 아무것도 바라지 마라.",
  "d1d": [
   "황제는 좋은 사람을, 포도를 맺고도 자랑하지 않는 포도나무에 비유했습니다.",
   "열매를 맺는 것이 포도나무의 본성이듯, 선을 행하는 것이 사람의 본성이라는 겁니다."
  ],
  "d1e": [
   "삼십 년 동안 차려 온 저녁 밥상.",
   "고맙다는 말은 없는데, 내일도 밥은 차려야 합니다."
  ],
  "d1f": "!알아주는 사람이 없어도, 그 밥상은 가족을 살렸습니다.",
  "d1g": [
   "오늘 밤에는, 오늘 한 좋은 일 하나를 떠올리고, 그 일을 아무에게도 말하지 않아 보세요.",
   "포도나무처럼요."
  ],
  "d1h": "그리고 그해 겨울, 황제에게 또 하나의 소식이 날아들었습니다.",
  "d2a": "북쪽 전선으로 함께 가던 길, 공동 황제이자 아우인 루키우스가, 마차 안에서 쓰러졌습니다.",
  "d2b": [
   "루키우스는 끝내 일어나지 못했습니다.",
   "황제는 아우를 신으로 모시는 장례를, 정성껏 치러 주었습니다."
  ],
  "d2c": "그러나 로마에는, 이상한 소문이 돌았습니다.",
  "r_sen": "“황제가, 자기 아우를 독살했다더군.”",
  "d2d": "황제는 그 소문에, 한마디도 답하지 않았습니다.",
  "m2a": "너는 선을 행했고, 그는 그 덕을 보았다.",
  "m2b": "그런데 왜, 바보처럼 세 번째 것을 찾는가.",
  "m2c": [
   "선을 행했으면 그것으로 끝이다.",
   "세 번째 것을 바라지 마라."
  ],
  "d2e": [
   "황제는 선을 행하는 일과, 그 일로 인정받는 일을 분명히 나누었습니다.",
   "앞의 것은 내 몫이고, 뒤의 것은 남의 몫이라는 겁니다."
  ],
  "d2f": [
   "십 년 동안 홀로 어머니 병간호를 했습니다.",
   "그런데 장례식장에서, 친척들은 한마디씩 거들기만 했습니다."
  ],
  "d2g": "!내가 한 일은, 남이 알아줘야 완성되는 일이 아닙니다.",
  "d2h": "오늘 밤에는, 내가 한 일에 붙여 둔 알아 달라는 마음을, 살짝 떼어 내 보세요.",
  "d2i": "그해 봄, 제국의 금고가 바닥을 드러냈습니다.",
  "d3a": [
   "역병으로 사람이 줄고, 북쪽에서는 게르만족이 국경을 넘어왔습니다.",
   "그런데 군대를 꾸릴 돈이, 없었습니다."
  ],
  "d3b": "원로원은 손쉬운 길을 말했습니다.",
  "t_sen": "“세금을 더 걷으면 됩니다, 폐하.”",
  "d3c": [
   "그러나 황제는 고개를 저었습니다.",
   "그리고 아무도 예상하지 못한 결정을 내렸습니다."
  ],
  "m3x": "“궁전의 것을, 팔겠소.”",
  "m3a": "죽은 뒤의 이름에 매달리는 사람은 잊는다.",
  "m3b": "그를 기억하는 사람들도, 곧 모두 떠난다는 것을.",
  "m3c": [
   "이름은 금방 잊힌다.",
   "지금, 옳은 일을 하라."
  ],
  "d3d": [
   "세금을 올리면 쉬웠을 겁니다.",
   "하지만 그 짐은, 역병에 지친 백성이 졌을 겁니다.",
   "황제는 이름을 남기는 일보다, 오늘의 옳은 일을 앞에 두었습니다."
  ],
  "d3e": [
   "또 밀린 승진 발표날.",
   "밤새 만든 보고서는, 상사의 이름으로 올라갔습니다."
  ],
  "d3f": "!이름은 남이 가져가도, 그 일을 해낸 사람은 나입니다.",
  "d3g": "오늘 밤에는, 이름 없이도 뿌듯했던 오늘의 일 하나를, 떠올려 보세요.",
  "d3h": "그렇게 트라야누스 광장에, 경매대가 세워졌습니다.",
  "d4a": [
   "경매는, 두 달 동안 이어졌다고 전해집니다.",
   "황금 잔과 수정 그릇, 대대로 내려온 조각상까지 하나씩 팔려 나갔습니다."
  ],
  "d4b": [
   "사람들은 웃었습니다.",
   "황제가 체면을 잃었다고.",
   "황후의 옷까지 내다 파는 황제라고."
  ],
  "c4": "“더 부르실 분 없소? 팔렸소!”",
  "d4c": "그렇게 모은 돈으로, 황제는 백성에게 세금을 더 걷지 않고 군대를 꾸렸습니다.",
  "m4a": "추울 때든 따뜻할 때든, 졸릴 때든 푹 잤을 때든.",
  "m4b": "칭찬을 듣든, 비난을 듣든.",
  "m4c": "칭찬을 듣든 비난을 듣든, 해야 할 일을 하라.",
  "d4d": [
   "스토아 철학자들은 이것을, 의무라고 불렀습니다.",
   "남의 박수와 상관없이, 내 자리에서 마땅히 할 일입니다."
  ],
  "d4e": [
   "새벽 세 시, 아무도 보지 않는 병동.",
   "간호사는 잠든 환자의 이불을, 다시 덮어 줍니다."
  ],
  "d4f": "!아무도 보지 않는 일이, 세상을 굴러가게 합니다.",
  "d4g": "오늘 밤에는, 내일 아무도 보지 않는 곳에서 할 일 하나를, 정해 보세요.",
  "d4h": [
   "몇 해 뒤, 다뉴브 전선.",
   "큰 승리를 거둔 병사들이, 황제 앞에 모여들었습니다."
  ],
  "d5a": [
   "병사들은 상여금을 요구했습니다.",
   "목숨을 걸고 싸웠으니, 그만한 상을 달라는 것이었습니다."
  ],
  "v_sol": "“폐하, 우리는 피를 흘렸습니다. 그에 맞는 상을 주십시오.”",
  "d5b": [
   "황제는 거절했습니다.",
   "그리고 이렇게 말했다고 전해집니다."
  ],
  "m5x": "“그대들에게 더 주는 것은, 그대들 부모와 형제의 피에서 짜내는 것이오.”",
  "d5c": [
   "병사들은 투덜거렸습니다.",
   "인기를 얻기 쉬운 길을, 황제는 또 마다한 것입니다."
  ],
  "m5a": "사람은 누구보다 자기를 사랑하면서도,",
  "m5b": "자기 생각보다, 남의 생각을 더 무겁게 여긴다.",
  "m5c": "남의 평가를, 내 판단보다 앞에 두지 마라.",
  "d5d": [
   "황제에게 인기는 목표가 아니었습니다.",
   "옳다고 판단한 일이 인기가 없을 때, 그는 판단 쪽을 택했습니다."
  ],
  "d5e": [
   "우리 반에서 나만 휴대폰이 없다는 아이의 말.",
   "엄마의 마음은, 하루에도 몇 번씩 흔들립니다."
  ],
  "d5f": "!미움받는 결정이, 틀린 결정은 아닙니다.",
  "d5g": "오늘 밤에는, 남의 눈 때문에 미뤄 둔 옳은 결정 하나를, 적어 보세요.",
  "d5h": "그날 밤, 막사에서 황제는, 자신을 비웃는 말들을 떠올렸습니다.",
  "d6a": [
   "로마에는 그를, 철학자 황제라고 비꼬는 사람들이 있었습니다.",
   "책을 붙들고 생각만 하는 황제라고."
  ],
  "d6b": "그러나 그날 밤 일기에, 황제는 다른 이야기를 적었습니다.",
  "m6a": "좋은 사람이란, 어떤 사람인가.",
  "m6b": "그것을 따지는 데, 남은 날을 쓰지 마라.",
  "m6c": "좋은 사람이 무엇인지 논하지 말고, 좋은 사람이 되어라.",
  "d6c": [
   "황제에게 철학은, 말이 아니라 행동이었습니다.",
   "경매대에 오른 황후의 옷이, 그가 쓴 어떤 문장보다 그의 철학을 잘 보여 주었습니다."
  ],
  "d6d": [
   "매주 토요일, 무료 급식소에 말없이 나와 밥을 푸는 할아버지가 있습니다.",
   "사진 한 장 남기지 않습니다."
  ],
  "d6e": [
   "!말보다 먼저, 손이 움직이는 사람.",
   "!그 사람이, 좋은 사람입니다."
  ],
  "d6f": "오늘 밤에는, 말로만 해 왔던 좋은 일 하나를, 이번 주에 직접 해 보세요.",
  "d6i": "그리고 전쟁이 끝난 뒤, 황제는 경매에서 물건을 산 사람들에게, 한 가지를 알렸습니다.",
  "d7a": [
   "원하는 사람은 물건을 돌려주고, 낸 돈을 다시 받아 가도 된다고.",
   "돌려주지 않는다고 해서, 아무도 벌하지 않았습니다."
  ],
  "d7b": [
   "누군가는 돌려주었고, 누군가는 간직했습니다.",
   "황제는 그 누구에게도, 고맙다는 말을 요구하지 않았습니다."
  ],
  "d7c": [
   "그리고 오랜 세월이 흐른 뒤, 사람들은 그를 로마 오현제의 마지막 황제로 기억했습니다.",
   "그를 알아준 것은, 시간이었습니다."
  ],
  "m7a": "나는 공동체를 위해, 무언가를 했는가.",
  "m7b": "그렇다면, 나는 이미 보상을 받았다.",
  "m7c": "공동체를 위해 일했다면, 나는 이미 보상받았다.",
  "d7d": [
   "황제는 보상을 바깥에서 찾지 않았습니다.",
   "좋은 일을 한 순간, 그 사람은 이미 조금 더 좋은 사람이 되어 있다는 겁니다."
  ],
  "d7e": [
   "삼십 년 다닌 회사의 마지막 날.",
   "송별회는 짧았고, 누구도 내 이름을 오래 기억하지 않을 겁니다."
  ],
  "d7f": "!하지만 그 삼십 년이, 한 가족을 키웠습니다.",
  "d7g": "오늘 밤에는, 내가 오래 해 온 일 하나에게, 잘했다고 말해 주세요.",
  "r1": "아무도 알아주지 않을 때, 황제가 일기에 남긴 일곱 문장을 다시 짚어 보겠습니다.",
  "r2": "첫째, 포도나무처럼, 선을 행하고 바라지 마라.",
  "r3": "둘째, 세 번째 것을 바라지 마라.",
  "r4": [
   "셋째, 이름은 금방 잊힌다.",
   "지금, 옳은 일을 하라."
  ],
  "r5": "넷째, 칭찬을 듣든 비난을 듣든, 할 일을 하라.",
  "r6": "다섯째, 남의 평가를, 내 판단보다 앞에 두지 마라.",
  "r7": "여섯째, 좋은 사람을 논하지 말고, 좋은 사람이 되어라.",
  "r8": "일곱째, 선을 행했다면, 이미 보상받았다.",
  "r9": "!알아주는 사람이 없어도, 좋은 일은 이미 일어났습니다.",
  "o1": "오늘 이야기가 마음에 닿으셨다면, 구독과 좋아요로 황제의 일기를 함께 이어 가 주세요.",
  "o2": "다음 이야기에서는, 아내를 잃은 밤 황제가 일기에 남긴 문장들을 들려드리겠습니다.",
  "t0": "오늘 밤, 잠들기 전에, 이 세 가지만 해 보세요.",
  "t1": [
   "하나.",
   "오늘 한 좋은 일 하나를, 아무에게도 말하지 말고 간직해 보세요."
  ],
  "t2": [
   "둘.",
   "내일, 아무도 보지 않는 곳에서 할 일 하나를, 정해 보세요."
  ],
  "t3": [
   "셋.",
   "오래 해 온 내 일에게, 잘했다고 말해 주세요."
  ]
 },
