 "subs": {
  "h01": [
   "휴대폰 연락처를 한번 열어 보십시오.",
   "몇 명이 들어 있습니까."
  ],
  "h02": [
   "오백 명, 어쩌면 천 명이 넘을지도 모릅니다."
  ],
  "h03": [
   "그런데 지난 한 달 동안,",
   "내가 먼저 전화를 건 사람은 몇 명입니까.",
   "아마 손에 꼽을 겁니다."
  ],
  "h04": [
   "우리는 이것을 쓸쓸한 일이라고 배웠습니다.",
   "나이가 들면 사람이 떠난다고요."
  ],
  "h05": [
   "모임이 줄고, 전화가 줄고, 경조사 봉투만 남는다고요."
  ],
  "h06": [
   "그런데 이상한 사람들이 있습니다.",
   "떠나가기를 기다리지 않고, 스스로 줄이는 사람들입니다."
  ],
  "h07": [
   "그리고 그들은, 나이가 들수록 오히려 편안해집니다."
  ],
  "p01": [
   "천팔백 년 전,",
   "세상에서 만나야 할 사람이 가장 많았던 한 남자도 같은 일을 했습니다."
  ],
  "p02": [
   "로마의 황제, 마르쿠스 아우렐리우스입니다."
  ],
  "p03": [
   "사람을 줄이는 사람과, 그저 사람이 줄어드는 사람.",
   "둘 사이의 차이는 단 하나입니다."
  ],
  "p04": [
   "그 하나는, 이 영상의 마지막에 말씀드리겠습니다."
  ],
  "y01": [
   "영수 씨의 이야기부터 하겠습니다.",
   "여러 사람의 이야기를 모아 다시 꾸민,",
   "한 사람의 이야기입니다."
  ],
  "y02": [
   "영수 씨는 올해 쉰여덟입니다.",
   "한 회사에서 스물여덟 해를 일했고,",
   "석 달 뒤면 정년입니다."
  ],
  "y03": [
   "어느 토요일 밤, 아내가 먼저 잠든 뒤,",
   "영수 씨는 식탁에 앉아 휴대폰 연락처를 처음부터 끝까지 넘겨 보았습니다."
  ],
  "y04": [
   "천이백 명이 조금 넘었습니다."
  ],
  "y05": [
   "거래처 부장, 이십 년 전 같은 부서 후배,",
   "이름만 보고는 얼굴이 떠오르지 않는 사람들."
  ],
  "y06": [
   "그는 문득 궁금해졌습니다.",
   "이 중에 지난 한 달 동안 통화한 사람은 몇 명일까."
  ],
  "y07": [
   "통화 기록을 열어 세어 보니, 여섯 명이었습니다.",
   "그중 넷은 일 때문이었습니다."
  ],
  "y08": [
   "남은 두 사람은, 아내와 딸이었습니다."
  ],
  "y09": [
   "영수 씨는 휴대폰을 엎어 놓고 한참 앉아 있었습니다."
  ],
  "y10": [
   "서운함도 아니고, 억울함도 아닌, 이상한 기분이었습니다."
  ],
  "y11": [
   "스물여덟 해 동안 쌓은 사람이 천이백 명인데,",
   "정년이 지나면 이 중 몇 명이 남을까."
  ],
  "y12": [
   "지난달,",
   "오랜 친구 하나가 영수 씨에게 돈을 빌려 갔습니다."
  ],
  "y13": [
   "봉투를 받아 든 친구는 고맙다는 말도 없이 일어섰습니다."
  ],
  "y14": [
   "지난 명절에는 다 큰 아들이 식탁에서 휴대폰만 보았습니다.",
   "영수 씨가 무슨 말을 해도 고개를 들지 않았습니다."
  ],
  "y15": [
   "그날 밤 영수 씨는 생각했습니다.",
   "사람이 떠나가는 게 아니라,",
   "나는 처음부터 혼자였던 건 아닐까."
  ],
  "y16": [
   "많은 분들이 이 밤을 압니다.",
   "쉰이 넘고, 예순이 가까워지면,",
   "누구나 한 번은 이 식탁에 앉게 됩니다."
  ],
  "y17": [
   "그런데 여기서 사람은 두 갈래로 나뉩니다."
  ],
  "y18": [
   "한쪽은 남은 사람이라도 붙잡으려 애씁니다.",
   "모임마다 나가고, 단체 대화방마다 답을 하고,",
   "서운한 일이 생겨도 참습니다."
  ],
  "y19": [
   "그리고 더 지칩니다."
  ],
  "y20": [
   "다른 한쪽은, 그 밤을 계기로 스스로 줄이기 시작합니다."
  ],
  "y21": [
   "놀라운 것은,",
   "두 번째 사람들이 더 외로워지지 않는다는 겁니다.",
   "오히려 더 단단해집니다.",
   "왜 그럴까요."
  ],
  "r01": [
   "먼저 알아야 할 것이 있습니다.",
   "나이가 들수록 사람이 줄어드는 것은,",
   "고장이 아니라 정상입니다."
  ],
  "r02": [
   "미국 스탠퍼드대학교의 심리학자 로라 카스텐슨은 이것을 오래 연구했습니다."
  ],
  "r03": [
   "사람은 남은 시간이 넉넉하다고 느낄 때,",
   "새로운 사람을 많이 만나려 합니다.",
   "언젠가 도움이 될지 모르니까요."
  ],
  "r04": [
   "그런데 남은 시간이 유한하다고 느끼기 시작하면,",
   "고르기 시작합니다.",
   "넓은 관계보다, 마음이 편한 소수를 택합니다."
  ],
  "r05": [
   "이것을 사회정서적 선택 이론이라고 부릅니다."
  ],
  "r06": [
   "중요한 것은,",
   "이 변화가 나이 든 사람들을 더 불행하게 만들지 않았다는 점입니다.",
   "관계의 수는 줄었지만,",
   "감정의 만족도는 오히려 높아졌습니다."
  ],
  "r07": [
   "영국의 인류학자 로빈 던바도 비슷한 이야기를 합니다."
  ],
  "r08": [
   "사람이 진짜로 가깝게 지낼 수 있는 사람은,",
   "가장 안쪽에 다섯 명 남짓입니다.",
   "그 바깥에 열다섯, 그 바깥에 쉰,",
   "그리고 얼굴과 이름을 아는 정도가 백오십 명입니다."
  ],
  "r09": [
   "연락처에 천이백 명이 있어도,",
   "마음이 닿는 사람은 원래 다섯 명 남짓이라는 뜻입니다."
  ],
  "r10": [
   "그리고 하버드대학교가 여든 해 넘게 같은 사람들을 따라간 연구가 있습니다.",
   "성인발달연구입니다."
  ],
  "r11": [
   "이 연구를 이끄는 로버트 월딩거 교수는 이렇게 정리합니다."
  ],
  "r12": [
   "여든 살에 가장 건강했던 사람들은,",
   "쉰 살 무렵 관계에 가장 만족했던 사람들이었다고요.",
   "관계의 수가 아니라, 관계의 질이었습니다."
  ],
  "r13": [
   "그러니까 영수 씨의 연락처가 줄어드는 것은 문제가 아닙니다.",
   "문제는, 줄어드는 것을 그냥 당하느냐,",
   "아니면 내가 고르느냐입니다."
  ],
  "e01": [
   "이제 한 남자를 만나 보겠습니다.",
   "서기 170년대,",
   "로마 제국은 북쪽 국경에서 끝없는 전쟁을 치르고 있었습니다."
  ],
  "e02": [
   "그 한가운데, 쉰 줄에 들어선 황제가 있었습니다.",
   "마르쿠스 아우렐리우스."
  ],
  "e03": [
   "그는 하루에도 수백 명을 만났습니다.",
   "원로원 의원, 장군, 청원하러 온 사람,",
   "아첨하러 온 사람, 그를 미워하는 사람."
  ],
  "e04": [
   "세상에서 가장 많은 사람을 상대해야 했던 남자였습니다."
  ],
  "e05": [
   "그 남자가 전쟁터를 오가며 밤마다 써 내려간 일기가 있습니다.",
   "훗날 『명상록』이라고 불리게 된 글입니다."
  ],
  "e06": [
   "그런데 그 일기의 첫 권을 펼쳐 보면,",
   "이상한 점이 있습니다.",
   "전쟁 이야기도, 정치 이야기도 없습니다."
  ],
  "e07": [
   "그 첫 권은 사람의 이름으로 채워져 있습니다."
  ],
  "m0": [
   "할아버지에게서는 온화함을 배웠다.",
   "어머니에게서는 검소함을 배웠다.",
   "스승 루스티쿠스에게서는,",
   "내 성품을 고치고 다듬어야 한다는 것을 배웠다."
  ],
  "e08": [
   "열 명이 훌쩍 넘는 사람들의 이름과,",
   "그들에게서 배운 것들."
  ],
  "e09": [
   "수만 명을 만난 남자가 일기의 첫머리에 남긴 것은,",
   "고마운 사람들의 짧은 명단이었습니다."
  ],
  "e10": [
   "그는 사람을 미워해서 줄인 것이 아니었습니다.",
   "누구를 마음에 남길지, 스스로 골랐던 것입니다."
  ],
  "e11": [
   "그렇다면 사람을 줄이는 사람들에게는,",
   "어떤 이유가 있는 걸까요.",
   "네 가지로 말씀드리겠습니다."
  ],
  "a01": [
   "첫 번째.",
   "그들은 사람에게 실망하지 않습니다.",
   "어떤 사람을 만날지 미리 알기 때문입니다."
  ],
  "a02": [
   "영수 씨가 가장 힘들었던 것은,",
   "친구가 고맙다는 말 없이 떠난 일이 아니었습니다.",
   "그 친구가 그럴 줄 몰랐다는 사실이었습니다."
  ],
  "a03": [
   "우리는 대개 사람에게 기대를 걸어 두고,",
   "그 기대가 무너질 때 상처를 받습니다."
  ],
  "a04": [
   "마르쿠스는 매일 아침,",
   "일을 시작하기 전에 스스로에게 이렇게 말했습니다."
  ],
  "m1": [
   "오늘 나는 참견하는 사람, 배은망덕한 사람, 오만한 사람,",
   "속이는 사람, 시기하는 사람을 만날 것이다."
  ],
  "a05": [
   "비관처럼 들리지만, 아닙니다.",
   "그는 이어서 이렇게 씁니다.",
   "그들이 그렇게 된 것은 무엇이 선하고 무엇이 악한지 모르기 때문이며,",
   "그들도 나와 같은 사람이라고."
  ],
  "a06": [
   "미리 알고 만나면, 같은 일을 겪어도 덜 다칩니다."
  ],
  "a07": [
   "사람을 줄이는 사람들은 차가운 사람이 아닙니다.",
   "기대를 사람마다 다르게 거는 사람들입니다."
  ],
  "a08": [
   "아무에게나 마음을 다 주지 않으니,",
   "아무에게나 다치지도 않습니다."
  ],
  "a09": [
   "영수 씨가 봉투를 건넨 그 친구를 미워할 필요는 없습니다.",
   "다만 그 친구에게는, 다음부터 그만큼만 기대하면 됩니다."
  ],
  "b01": [
   "두 번째.",
   "그들은 약속을 줄이는 게 아니라,",
   "필요 없는 것을 덜어 냅니다."
  ],
  "b02": [
   "정년을 앞둔 영수 씨의 달력에는 한 달에 모임이 열한 개 있었습니다.",
   "동창회, 옛 부서 모임, 거래처 송년회,",
   "이름만 남은 산악회."
  ],
  "b03": [
   "그중 다녀와서 마음이 가벼웠던 자리는 몇 개였을까요.",
   "영수 씨는 솔직하게 세어 보았습니다.",
   "둘이었습니다."
  ],
  "b04": [
   "마르쿠스는 일기에 이렇게 적었습니다."
  ],
  "m2": [
   "평온하고 싶다면, 적게 하라.",
   "꼭 필요한 일만 하라."
  ],
  "b05": [
   "그리고 이렇게 덧붙입니다.",
   "우리가 하는 말과 행동의 대부분은 필요 없는 것이니,",
   "그것을 덜어 내면 시간도 생기고 마음도 고요해진다고."
  ],
  "b06": [
   "여기서 오해하면 안 되는 것이 있습니다.",
   "덜어 낸다는 것은 연락을 끊는다는 뜻이 아닙니다."
  ],
  "b07": [
   "다녀오면 지치기만 하는 자리에,",
   "의무감으로 가지 않는 것입니다."
  ],
  "b08": [
   "대신 그렇게 남은 시간을,",
   "다녀오면 마음이 따뜻해지는 사람에게 씁니다."
  ],
  "b09": [
   "열한 개의 모임 대신 두 개의 모임에 가는 사람은,",
   "덜 외로운 것이 아니라 더 깊이 연결되어 있습니다."
  ],
  "c01": [
   "세 번째.",
   "그들은 곁에 두는 사람이 내 마음의 색을 정한다는 것을 압니다."
  ],
  "c02": [
   "어떤 사람과 한 시간을 보내고 나면 이유 없이 기운이 빠집니다.",
   "남 이야기, 돈 이야기,",
   "누가 잘되고 누가 망했다는 이야기."
  ],
  "c03": [
   "어떤 사람과 한 시간을 보내고 나면 내가 조금 나은 사람이 된 것 같습니다."
  ],
  "c04": [
   "마르쿠스는 이렇게 썼습니다."
  ],
  "m3": [
   "네 마음은 네가 자주 떠올리는 것들을 닮아 간다.",
   "영혼은 생각에 물든다."
  ],
  "c05": [
   "자주 떠올리는 것에는, 자주 만나는 사람도 들어갑니다."
  ],
  "c06": [
   "그래서 그는 또 이렇게 적었습니다.",
   "기운을 내고 싶을 때는,",
   "곁에 있는 사람들의 좋은 점을 떠올려 보라고.",
   "누구는 부지런하고, 누구는 겸손하고, 누구는 너그럽다고."
  ],
  "c07": [
   "일기 첫 권의 그 명단이 바로 이것이었습니다.",
   "그는 힘든 밤마다,",
   "자신을 물들인 좋은 사람들을 다시 떠올렸던 것입니다."
  ],
  "c08": [
   "나이가 들수록 사람을 줄이는 사람들은,",
   "결국 자기 마음의 색을 지키는 사람들입니다.",
   "남은 시간 동안 어떤 색으로 물들고 싶은지,",
   "스스로 고르는 사람들입니다."
  ],
  "d01": [
   "네 번째.",
   "그들은 혼자 있는 시간을 빈자리가 아니라 쉼터로 씁니다."
  ],
  "d02": [
   "사람을 줄이면 가장 먼저 찾아오는 것이 혼자 있는 시간입니다.",
   "많은 사람이 이 시간을 견디지 못해 다시 아무 모임에나 나갑니다."
  ],
  "d03": [
   "마르쿠스는 이 문제를 정확하게 알고 있었습니다.",
   "사람들은 쉬고 싶을 때 시골로, 바닷가로,",
   "산으로 떠나려 한다.",
   "그러나 언제든 자기 안으로 물러날 수 있다."
  ],
  "m4": [
   "사람이 물러날 수 있는 곳 중에,",
   "자기 마음보다 고요하고 편안한 곳은 없다."
  ],
  "d04": [
   "영수 씨는 요즘 토요일 아침마다 혼자 산에 오릅니다.",
   "처음 몇 주는 어색했습니다."
  ],
  "d05": [
   "그런데 어느 날 정상에서,",
   "처음 보는 또래 사람들과 보온병 차를 나눠 마시며 한참을 웃었습니다."
  ],
  "d06": [
   "혼자 있는 법을 아는 사람에게는,",
   "이상하게도 좋은 사람이 찾아옵니다.",
   "매달리지 않으니, 상대도 편안하기 때문입니다."
  ],
  "z01": [
   "이제 처음에 약속드린 이야기를 하겠습니다.",
   "사람을 줄이는 사람과, 그저 사람이 줄어드는 사람.",
   "둘의 차이는 단 하나입니다."
  ],
  "z02": [
   "!줄어드는 사람은, 누가 떠났는지를 셉니다."
  ],
  "z03": [
   "!줄이는 사람은, 누구를 남길지를 고릅니다."
  ],
  "z04": [
   "같은 다섯 명이 남아도,",
   "떠나간 천 명을 세는 사람은 외롭고,",
   "남은 다섯 명을 고른 사람은 넉넉합니다."
  ],
  "z05": [
   "수만 명을 만났던 황제가 일기 첫 권에 적은 것은 떠난 사람들의 명단이 아니었습니다.",
   "고마운 사람들의 명단이었습니다."
  ],
  "z06": [
   "그날 밤 식탁에 앉아 있던 영수 씨는,",
   "이제 연락처 대신 공책을 엽니다.",
   "그리고 다섯 사람의 이름을 적습니다."
  ],
  "q01": [
   "여러분에게 끝까지 남은 한 사람은 누구입니까.",
   "이름은 적지 않으셔도 됩니다.",
   "어떤 사람인지만, 댓글로 들려주세요."
  ],
  "t01": [
   "오늘 밤, 이 세 가지만 해 보십시오."
  ],
  "t02": [
   "첫째,",
   "지난 한 달 동안 내가 먼저 연락한 사람의 이름을 적어 보십시오."
  ],
  "t03": [
   "둘째, 끝까지 곁에 두고 싶은 다섯 사람을 적고,",
   "그중 한 사람에게 오늘 고맙다고 말해 보십시오."
  ],
  "t04": [
   "셋째, 다녀오면 지치기만 하는 약속 하나를,",
   "정중하게 미뤄 보십시오."
  ],
  "o1": [
   "좋아요와 구독은, 영상 제작에 큰 힘이 됩니다.",
   "감사합니다."
  ],
  "o2": [
   "다음 이야기에서도,",
   "황제가 일기에 남긴 문장으로 오늘을 함께 짚어 보겠습니다."
  ]
 },
