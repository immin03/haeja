[{"t0": 116.85799999999999, "t1": 124.594, "lines": ["아침마다 스스로에게 말하라,", "오늘 나는 무례한 사람들을 만날 것이다."], "src": "명상록 2권 1절"}, {"t0": 218.25399999999996, "t1": 225.46199999999996, "lines": ["그가 무엇을 옳다고 믿었는지 보면,", "화 대신 연민이 남는다."], "src": "명상록 7권 26절"}, {"t0": 316.8419999999999, "t1": 324.04999999999995, "lines": ["불가능한 것을 바라지 마라,", "무례한 사람이 없는 세상은 없다."], "src": "명상록 9권 42절"}, {"t0": 403.58599999999996, "t1": 410.7459999999999, "lines": ["상처받았다는 생각을 버려라,", "그러면 상처도 사라진다."], "src": "명상록 4권 7절"}, {"t0": 484.26199999999983, "t1": 494.30199999999985, "lines": ["누가 나를 경멸하는가, 그것은 그의 몫이다.", "내 몫은, 경멸받을 일을 하지 않는 것이다."], "src": "명상록 11권 13절"}, {"t0": 567.65, "t1": 573.562, "lines": ["가장 좋은 복수는,", "그와 같아지지 않는 것이다."], "src": "명상록 6권 6절"}, {"t0": 636.3980000000001, "t1": 642.1900000000002, "lines": ["사람은 서로를 위해 존재한다,", "가르치거나, 견디거나."], "src": "명상록 8권 59절"}]