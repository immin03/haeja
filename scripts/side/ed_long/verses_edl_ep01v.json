[{"t0": 85.35199999999999, "t1": 91.35199999999999, "lines": ["남의 생각을 짐작하느라,", "남은 날들을 쓰지 마라."], "src": "명상록 3권 4절"}, {"t0": 177.196, "t1": 182.57999999999998, "lines": ["남의 잘못은,", "그것이 생긴 자리에 두어라."], "src": "명상록 9권 20절"}, {"t0": 269.596, "t1": 276.27599999999995, "lines": ["칭찬받는다고,", "더 나아지지도 더 나빠지지도 않는다."], "src": "명상록 4권 20절"}, {"t0": 349.35599999999994, "t1": 357.37999999999994, "lines": ["사람은 어디로 물러나도,", "자기 마음속보다 고요한 곳을 찾지 못한다."], "src": "명상록 4권 3절"}, {"t0": 443.73199999999997, "t1": 452.644, "lines": ["좋은 조부모와 부모와 스승과 벗을", "만난 것에 감사한다."], "src": "명상록 1권 17절"}, {"t0": 535.3360000000001, "t1": 541.5360000000002, "lines": ["화는, 화나게 한 일보다", "우리를 더 아프게 한다."], "src": "명상록 11권 18절"}, {"t0": 608.1240000000001, "t1": 615.9800000000002, "lines": ["하루하루를 마지막 날처럼 보내는 것,", "거기에 성품의 완성이 있다."], "src": "명상록 7권 69절"}]