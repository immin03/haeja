 "subs": {
  "h2": "가장 믿던 장군이, 황제가 죽었다고 선언했습니다.",
  "m_h3a": "나는 아직 살아 있다.",
  "m_h3b": "!그런데 그는, 이미 나를 묻었다.",
  "h4": "그날 밤, 황제는 아무에게도 보여 주지 않을 일기를 펼쳤습니다.",
  "s1": [
   "혹시 이런 저녁, 보내 보신 적 있으십니까?",
   "하루 종일, 휴대폰이 한 번도 울리지 않은 날."
  ],
  "s2": "오랜 친구를 만나고 돌아오는 길이, 오히려 더 허전했던 밤 말입니다.",
  "s3": [
   "이천 년 전, 세상에서 가장 힘센 사람도 같은 밤을 보냈습니다.",
   "!그날 밤 그가 일기에 남긴 일곱 문장"
  ],
  "c1a": [
   "전령이 물러간 뒤에도,",
   "황제는 편지를 내려놓지 못했습니다.",
   "아비디우스 카시우스.",
   "동방의 전쟁을 승리로 이끌고, 황제가 동방 전체를 맡겼던 장군이었습니다."
  ],
  "m_c1b1": "그는 지금 무슨 생각을 하고 있을까.",
  "m_c1b2": "누가 그의 편에 섰을까.",
  "m_c1b3": "그만두자.",
  "m_c1b4": "!남의 생각을 짐작하느라, 남은 날들을 쓰지 마라.",
  "c1c": [
   "황제는 이 생각을 일기 곳곳에 되풀이해 적었습니다.",
   "스토아 철학에서는 이것을,",
   "~",
   "남의 마음은,",
   "!언제나 내 힘이 닿지 않는 쪽에 있습니다."
  ],
  "c1d": [
   "회의가 끝난 뒤,",
   "나를 두고 뒷말을 했다는 동료.",
   "며칠째 답이 없는 오랜 친구.",
   "우리는 그 사람의 속을 짐작하느라,",
   "!밤을 통째로 씁니다."
  ],
  "c1e": [
   "오늘 밤에는, 그 사람 대신 나에게 물어보세요.",
   "~"
  ],
  "c1f": "그리고 몇 달 뒤, 황제의 막사에 상자 하나가 도착합니다.",
  "m_x1": "~"
 }
