{
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(social|docs|media)/(.*)\\.mp4",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/mp4"
        }
      ]
    },
    {
      "source": "/(social|docs|media)/(.*)\\.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/media/kakao/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ig",
      "destination": "/start?utm_source=ig-bio",
      "permanent": false
    },
    {
      "source": "/th",
      "destination": "/start?utm_source=threads-bio",
      "permanent": false
    },
    {
      "source": "/yt",
      "destination": "/start?utm_source=youtube-bio",
      "permanent": false
    },
    {
      "source": "/soxl",
      "destination": "/lev?p=soxl",
      "permanent": false
    },
    {
      "source": "/g",
      "destination": "/start?utm_source=g-hub",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/naver/:id/:file",
      "destination": "https://raw.githubusercontent.com/immin03/haeja/main/naver/:id/:file"
    },
    {
      "source": "/naver/:id",
      "destination": "/api/naver?p=:id"
    },
    {
      "source": "/naver",
      "destination": "/api/naver"
    },
    {
      "source": "/social/reels/:id/reel.mp4",
      "destination": "/api/reel?id=:id"
    },
    {
      "source": "/docs/emperor/ep/:file(.+\\.mp4)",
      "destination": "https://msjbrwyzkiueqnzjeicm.supabase.co/storage/v1/object/public/media/docs/emperor/ep/:file"
    },
    {
      "source": "/social/side/gen/:file(.+\\.mp4)",
      "destination": "https://msjbrwyzkiueqnzjeicm.supabase.co/storage/v1/object/public/media/social/side/gen/:file"
    },
    {
      "source": "/social/:path*",
      "destination": "https://raw.githubusercontent.com/immin03/haeja/main/social/:path*"
    },
    {
      "source": "/docs/:path*",
      "destination": "https://raw.githubusercontent.com/immin03/haeja/main/docs/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://raw.githubusercontent.com/immin03/haeja/main/media/:path*"
    }
  ],
  "ignoreCommand": "git rev-parse -q --verify HEAD^ >/dev/null || exit 1; ! git diff --name-only HEAD^ HEAD | grep -qvE '^(scripts/|supabase/|\\.github/|README\\.md$|naver/|social/|media/|docs/)'"
}