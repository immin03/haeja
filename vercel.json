{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ig",
      "destination": "/start?utm_source=ig-bio",
      "permanent": false
    },
    {
      "source": "/th",
      "destination": "/start?utm_source=threads-bio",
      "permanent": false
    },
    {
      "source": "/yt",
      "destination": "/start?utm_source=youtube-bio",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/social/reels/:id/reel.mp4",
      "destination": "https://msjbrwyzkiueqnzjeicm.supabase.co/storage/v1/object/public/media/social/reels/:id/reel.mp4"
    },
    {
      "source": "/docs/emperor/ep/:file",
      "destination": "https://msjbrwyzkiueqnzjeicm.supabase.co/storage/v1/object/public/media/docs/emperor/ep/:file"
    },
    {
      "source": "/social/side/gen/:file",
      "destination": "https://msjbrwyzkiueqnzjeicm.supabase.co/storage/v1/object/public/media/social/side/gen/:file"
    }
  ]
}
